<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Styles.Resources>
        <!-- Font Families -->
        <FontFamily x:Key="DefaultFontFamily">avares://Avalonia.Fonts.Inter/#Inter</FontFamily>
        
        <!-- Font Sizes -->
        <x:Double x:Key="FontSizeXS">11</x:Double>
        <x:Double x:Key="FontSizeSM">12</x:Double>
        <x:Double x:Key="FontSizeMD">13</x:Double>
        <x:Double x:Key="FontSizeLG">14</x:Double>
        <x:Double x:Key="FontSizeXL">16</x:Double>
        <x:Double x:Key="FontSize2XL">18</x:Double>
        <x:Double x:Key="FontSize3XL">20</x:Double>
        <x:Double x:Key="FontSize4XL">24</x:Double>
        <x:Double x:Key="FontSize5XL">28</x:Double>
        <x:Double x:Key="FontSize6XL">32</x:Double>
        
        <!-- Font Weights -->
        <FontWeight x:Key="FontWeightLight">Light</FontWeight>
        <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
        <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
        <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
        <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    </Styles.Resources>
    
    <!-- Text Styles -->
    <Style Selector="TextBlock.Heading1">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize5XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Heading2">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize4XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Heading3">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize3XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Heading4">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize2XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.BodyLarge">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Body">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.BodySmall">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Label">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Value">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.Unit">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- ============================ Page scaffolding ============================
         These classes are referenced by every page. They were previously
         unstyled, which is why pages rendered as unformatted debug text. -->

    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize4XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="LetterSpacing" Value="-0.4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="1.1" />
    </Style>

    <Style Selector="TextBlock.MetricValue">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize5XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="LetterSpacing" Value="-0.8" />
    </Style>
</Styles>