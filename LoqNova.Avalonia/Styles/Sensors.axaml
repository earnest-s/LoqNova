<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Sensor Bar -->
    <Style Selector="Border.SensorBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    
    <Style Selector="Border.SensorBarFill">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <!-- Sensor Progress Bar -->
    <Style Selector="ProgressBar.SensorProgressBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>
    
    <!-- CPU Usage Bar -->
    <Style Selector="ProgressBar.CpuUsageBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="#0078D4" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>
    
    <!-- GPU Usage Bar -->
    <Style Selector="ProgressBar.GpuUsageBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="#00B294" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>
    
    <!-- Temperature Bar -->
    <Style Selector="ProgressBar.TemperatureBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="#E81123" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>
    
    <!-- Fan Speed Bar -->
    <Style Selector="ProgressBar.FanSpeedBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="#744DA9" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>
    
    <!-- Sensor Card Layout -->
    <Style Selector="Border.SensorCardLayout">
        <Setter Property="Margin" Value="4" />
    </Style>
    
    <Style Selector="TextBlock.SensorCardTitle">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    
    <Style Selector="TextBlock.SensorCardValue" />
    <Style Selector="TextBlock.SensorCardUnit" />
    
    <!-- Sensor Grid -->
    <Style Selector="Grid.SensorGrid" />
</Styles>