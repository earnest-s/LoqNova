<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:LoqNova.Avalonia.Converters">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="Styles/Colors.axaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <!-- Global Converters -->
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:EnumToDisplayConverter x:Key="EnumToDisplayConverter" />
    <local:RgbZoneColorToBrushConverter x:Key="RgbZoneColorToBrushConverter" />
</ResourceDictionary>