<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Sidebar shell ============================ -->

    <Style Selector="Border.NavSidebar">
        <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Width" Value="{StaticResource SidebarWidth}" />
        <Setter Property="MinWidth" Value="{StaticResource SidebarWidth}" />
    </Style>

    <Style Selector="Border.NavBrandPlate">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================ Navigation items ============================
         A single item template is shared by the primary list and the footer
         list, so both render identically. -->

    <Style Selector="Button.NavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLgBox}" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    </Style>

    <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Left accent rail marks the active destination. -->
    <Style Selector="Border.NavRail">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="PathIcon.NavIcon">
        <Setter Property="Width" Value="{StaticResource IconSize}" />
        <Setter Property="Height" Value="{StaticResource IconSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.NavItemLabel">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Sidebar chrome ============================ -->

    <Style Selector="TextBlock.NavBrand">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.NavBrandMeta">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="Border.NavFooterPlate">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,6,0,10" />
    </Style>

    <Style Selector="Separator.NavSeparator">
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,8" />
    </Style>

    <!-- ============================ Window chrome ============================ -->

    <Style Selector="Border.TitleBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
    </Style>

    <Style Selector="TextBlock.TitleBarText">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.CaptionButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.CaptionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    </Style>

    <Style Selector="Button.CaptionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="Button.CaptionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
</Styles>
