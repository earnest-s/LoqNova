<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Navigation Sidebar -->
    <Style x:Key="NavigationSidebar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Width" Value="240" />
        <Setter Property="MinWidth" Value="60" />
    </Style>
    
    <!-- Navigation Item -->
    <Style x:Key="NavigationItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="8,2" />
    </Style>
    
    <Style x:Key="NavigationItemIcon" TargetType="PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <Style x:Key="NavigationItemLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- Navigation Item Selected State -->
    <Style x:Key="NavigationItemSelected" TargetType="Button" BasedOn="{StaticResource NavigationItem}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    </Style>
    
    <Style x:Key="NavigationItemSelectedIcon" TargetType="PathIcon" BasedOn="{StaticResource NavigationItemIcon}">
        <Setter Property="Foreground" Value="White" />
    </Style>
    
    <Style x:Key="NavigationItemSelectedLabel" TargetType="TextBlock" BasedOn="{StaticResource NavigationItemLabel}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    
    <!-- Footer Navigation Item -->
    <Style x:Key="FooterNavigationItem" TargetType="Button" BasedOn="{StaticResource NavigationItem}">
        <Setter Property="Margin" Value="8,2" />
    </Style>
    
    <!-- Navigation Separator -->
    <Style x:Key="NavigationSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="16,8" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</ResourceDictionary>