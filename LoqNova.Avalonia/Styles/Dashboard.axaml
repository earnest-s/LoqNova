<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Dashboard composition primitives

         The dashboard's own instrument chrome: the device cards that hold
         each CPU/GPU instrument, their telemetry rows, the fan readout and
         the quick-control tiles.

         The instruments themselves (ClusterGauge, TemperatureGauge and
         AnalogFanControl) paint from the same colour tokens in code, so
         these classes only describe the surrounding layout. Everything here
         resolves through the shared tokens, so the whole dashboard follows
         the theme and accent without local colours.
         ============================================================ -->

    <!-- ==================== Instrument cluster ====================
         One continuous cluster holding both device instruments (CPU / GPU),
         mirrored about a centre rule so the two halves read as parts of a
         single instrument rather than as separate boxes. -->

    <Style Selector="Border.InstrumentCluster">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLgBox}" />
        <Setter Property="Padding" Value="{StaticResource InsetLg}" />
    </Style>

    <!-- The glyph naming each device. The channel colour is applied by the page
         on Foreground, so the icon itself - not a decorative dot - carries the
         device identity. -->
    <Style Selector="PathIcon.ClusterDeviceIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The hairline rule that separates the two halves of the cluster and the
         headings. Width only: the grid stretches it vertically. -->
    <Style Selector="Border.ClusterDivider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style Selector="TextBlock.DeviceTitle">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LetterSpacing" Value="0.4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Names one part of an instrument: "Temperature", "Fan". -->
    <Style Selector="TextBlock.InstrumentCaption">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="0.8" />
    </Style>

    <!-- ==================== Telemetry rows ====================
         A label on the left and its reading on the right, used for every
         channel that is not drawn on a dial, so the numbers share one
         alignment down the instrument. -->

    <Style Selector="TextBlock.TelemetryLabel">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.TelemetryValue">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A secondary line derived from a reading, e.g. a reported maximum. -->
    <Style Selector="TextBlock.InstrumentMeta">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The live fan reading beside the fan dial. -->
    <Style Selector="TextBlock.FanValue">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize4XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LetterSpacing" Value="-0.6" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="TextBlock.FanUnit">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- A hairline rule between two parts of an instrument card. -->
    <Style Selector="Border.CardDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- ==================== Quick controls ====================
         The dashboard's feature tiles reuse the shared widget card but align
         to the instrument cards: same padding ramp, same radius, one minimum
         height so a tile row never staggers. -->

    <Style Selector="Border.WidgetCard.ControlTile">
        <Setter Property="Padding" Value="{StaticResource InsetMd}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLgBox}" />
        <Setter Property="MinHeight" Value="104" />
    </Style>

    <Style Selector="Border.ControlTile TextBlock.WidgetTitle">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

</Styles>
