<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="PrimaryButton:pointerover" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#005A9E" />
    </Style>
    
    <Style x:Key="PrimaryButton:pressed" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#004578" />
    </Style>
    
    <Style x:Key="PrimaryButton:disabled" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
    </Style>
    
    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="SecondaryButton:pointerover" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    </Style>
    
    <Style x:Key="SecondaryButton:pressed" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>
    
    <Style x:Key="SecondaryButton:disabled" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DisabledBrush}" />
    </Style>
    
    <!-- Outline Button -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="OutlineButton:pointerover" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    </Style>
    
    <Style x:Key="OutlineButton:pressed" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>
    
    <!-- Ghost Button -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="GhostButton:pointerover" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style x:Key="GhostButton:pressed" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>
    
    <!-- Icon Button -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="IconButton:pointerover" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style x:Key="IconButton:pressed" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>
    
    <!-- Preset Button (for RGB keyboard) -->
    <Style x:Key="PresetButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="PresetButton:pointerover" TargetType="Button" BasedOn="{StaticResource PresetButton}">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    </Style>
    
    <Style x:Key="PresetButton:pressed" TargetType="Button" BasedOn="{StaticResource PresetButton}">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>
    
    <Style x:Key="PresetButtonSelected" TargetType="Button" BasedOn="{StaticResource PresetButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    
    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style x:Key="DangerButton:pointerover" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Background" Value="#C5001B" />
    </Style>
    
    <Style x:Key="DangerButton:pressed" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Background" Value="#A00017" />
    </Style>
</ResourceDictionary>