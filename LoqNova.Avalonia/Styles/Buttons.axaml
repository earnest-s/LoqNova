<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Button system ============================
         Every button derives its metrics from design tokens so headers and
         toolbars stay visually consistent. -->

    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Primary action -->
    <Style Selector="Button.PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <!-- A constant 1px border keeps the content box stable when the focus
             ring appears; the border itself is transparent until focused. -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <Style Selector="Button.PrimaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    </Style>

    <Style Selector="Button.PrimaryButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>

    <!-- Secondary: filled neutral surface -->
    <Style Selector="Button.SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.SecondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Button.SecondaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <Style Selector="Button.SecondaryButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>

    <!-- Outline -->
    <Style Selector="Button.OutlineButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.OutlineButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.OutlineButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <!-- Ghost: low emphasis inline action -->
    <Style Selector="Button.GhostButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.GhostButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Button.GhostButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <!-- Hyperlink-style button: a text affordance with an optional leading icon.
         Used for the About page's links, library and folder entries. -->
    <Style Selector="Button.LinkButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.LinkButton PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.LinkButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <Style Selector="Button.LinkButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <!-- Icon button inside content areas -->
    <Style Selector="Button.IconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Button.IconButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <!-- RGB preset chips -->
    <Style Selector="Button.PresetButton">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PresetButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.PresetButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <Style Selector="Button.PresetButtonSelected">
        <Setter Property="Background" Value="{DynamicResource PrimaryMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Destructive action -->
    <Style Selector="Button.DangerButton">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.DangerButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
    </Style>

    <Style Selector="Button.DangerButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
    </Style>

    <!-- Number-pad key for the Macro page. WPF sizes these at 56x56 and switches the
         selected key to the primary appearance while the rest stay secondary. -->
    <Style Selector="Button.KeyPadKey">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.KeyPadKey:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>

    <Style Selector="Button.KeyPadKey.selected">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- ================================================================
         Keyboard focus

         Every button variant reserves a 1px border so that the focus ring
         can appear without the content shifting. Buttons that carry an
         accent fill use the on-accent colour; everything else uses the
         neutral focus ring.
         ================================================================ -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    </Style>

    <Style Selector="Button.PrimaryButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                      Button.DangerButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                      Button.PresetButtonSelected:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- ================================================================
         Disabled

         Variants that paint their own colours dim out; variants that only
         rely on the Fluent defaults fall back to a muted foreground.
         ================================================================ -->
    <Style Selector="Button.OutlineButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.GhostButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.IconButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.LinkButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.PresetButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.PresetButtonSelected:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.DangerButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.KeyPadKey:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
    </Style>

    <Style Selector="Button.OutlineButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DisabledBrush}" />
    </Style>

    <Style Selector="Button.GhostButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.IconButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.LinkButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.PresetButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                      Button.KeyPadKey:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

</Styles>
