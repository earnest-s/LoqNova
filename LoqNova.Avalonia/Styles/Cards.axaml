<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LoqNova.Avalonia.Views.Controls">
    
    <!-- Base Card Style -->
    <Style x:Key="BaseCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    
    <!-- Card with Hover Effect -->
    <Style x:Key="HoverCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Style.Triggers>
            <Trigger Property="IsPointerOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Feature Card Style -->
    <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Setter Property="Margin" Value="4" />
    </Style>
    
    <!-- Sensor Card Style -->
    <Style x:Key="SensorCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MaxWidth" Value="180" />
    </Style>
    
    <!-- Card Header -->
    <Style x:Key="CardHeader" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading4}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    
    <Style x:Key="CardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    
    <!-- Card Value -->
    <Style x:Key="CardValue" TargetType="TextBlock" BasedOn="{StaticResource Value}" />
    <Style x:Key="CardUnit" TargetType="TextBlock" BasedOn="{StaticResource Unit}" />
    
    <!-- Card Actions -->
    <Style x:Key="CardActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- Toggle Card -->
    <Style x:Key="ToggleCard" TargetType="Border" BasedOn="{StaticResource FeatureCard}" />
    
    <!-- ComboBox Card -->
    <Style x:Key="ComboBoxCard" TargetType="Border" BasedOn="{StaticResource FeatureCard}" />
    
    <!-- Button Card -->
    <Style x:Key="ButtonCard" TargetType="Border" BasedOn="{StaticResource FeatureCard}" />
    
    <!-- Custom Card -->
    <Style x:Key="CustomCard" TargetType="Border" BasedOn="{StaticResource FeatureCard}" />
</ResourceDictionary>