<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoqNova.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LOQ Nova/Styles/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- AccentColor is the design-system PrimaryColor so Fluent controls
             (checkbox, radio, slider, focus) match the LOQ Nova palette
             instead of the Windows system accent. -->
        <FluentTheme AccentColor="{StaticResource PrimaryColor}" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Typography.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Layout.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Buttons.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Cards.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Navigation.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Sensors.axaml" />
    </Application.Styles>
</Application>