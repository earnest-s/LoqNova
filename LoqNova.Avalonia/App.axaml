<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoqNova.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LOQ Nova/Styles/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- The ColorPicker package ships only the Simple theme. Including a Fluent path
       that does not exist leaves ColorView with no template, which throws as soon as
       the editor is realised, so this path must match the package exactly. -->
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Typography.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Layout.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Buttons.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Cards.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Navigation.axaml" />
        <StyleInclude Source="avares://LOQ Nova/Styles/Sensors.axaml" />
    </Application.Styles>
</Application>