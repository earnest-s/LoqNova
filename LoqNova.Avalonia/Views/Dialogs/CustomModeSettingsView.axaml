<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.CustomModeSettingsView"
             x:DataType="dialogs:CustomModeSettingsViewModel">

    <!-- Custom Mode settings, reproducing WPF's GodModeSettingsWindow. Every row is
         populated from the GodModePreset the controller reports; rows the hardware
         does not support are hidden rather than showing a fabricated value. -->
    <Border Classes="DialogCard" Width="620" MaxHeight="720">
        <DockPanel Classes="DialogRoot" LastChildFill="True">

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Classes="DialogHeader">
                <TextBlock Classes="DialogTitle" Text="Custom Mode Settings" />
                <TextBlock Classes="DialogSubtitle" Text="{Binding ActivePresetName, StringFormat='Active preset: {0}'}" />
            </StackPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Classes="DialogFooterBlock">
                <Border Classes="Callout Warning" Margin="0,0,0,8"
                        IsVisible="{Binding VantageWarning, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding VantageWarning}" Classes="CalloutText" />
                </Border>

                <Border Classes="Callout Warning" Margin="0,0,0,8"
                        IsVisible="{Binding LegionZoneWarning, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding LegionZoneWarning}" Classes="CalloutText" />
                </Border>

                <Border Classes="Callout Danger" Margin="0,0,0,8"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Classes="CalloutText" Text="{Binding ErrorMessage}" />
                </Border>

                <StackPanel Classes="DialogActions">
                    <Button Classes="GhostButton" Content="Refresh"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding RefreshCommand}" />
                    <Button Classes="GhostButton" Content="Close"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding CloseCommand}" />
                    <Button Classes="PrimaryButton" Content="Save"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource SpaceLg}">

                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="CPU" Classes="SectionHeader" />
                        <ItemsControl ItemsSource="{Binding CpuSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:CustomModeSettingViewModel">
                                    <StackPanel Classes="FieldRow"
                                                IsVisible="{Binding IsSupported}">
                                        <TextBlock Text="{Binding Title}" Classes="FieldLabel" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- WPF's GodModeValueControl is dual-mode: a
                                                 slider when the backend reports a
                                                 continuous StepperValue, and a combo
                                                 box when it reports discrete Steps. -->
                                            <Slider Grid.Column="0"
                                                    IsVisible="{Binding !IsDiscrete}"
                                                    Minimum="{Binding Minimum}"
                                                    Maximum="{Binding Maximum}"
                                                    TickFrequency="{Binding Step}"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Value, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="0" Classes="Control"
                                                      IsVisible="{Binding IsDiscrete}"
                                                      ItemsSource="{Binding Steps}"
                                                      SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                            <TextBlock Grid.Column="1" Classes="FieldValue"
                                                       Text="{Binding ValueText}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="GPU" Classes="SectionHeader" />
                        <ItemsControl ItemsSource="{Binding GpuSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:CustomModeSettingViewModel">
                                    <StackPanel Classes="FieldRow"
                                                IsVisible="{Binding IsSupported}">
                                        <TextBlock Text="{Binding Title}" Classes="FieldLabel" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Grid.Column="0"
                                                    Minimum="{Binding Minimum}"
                                                    Maximum="{Binding Maximum}"
                                                    TickFrequency="{Binding Step}"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Value, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Classes="FieldValue"
                                                       Text="{Binding ValueText}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Fans" Classes="SectionHeader" />
                        <StackPanel Spacing="{StaticResource SpaceXs}" IsVisible="{Binding IsFanFullSpeedSupported}">
                            <TextBlock Text="Fan Full Speed" Classes="FieldLabel" />
                            <ToggleSwitch Classes="Control" IsChecked="{Binding FanFullSpeed, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Fan curve. WPF hides the curve editor while full speed is
                             on, because the two contradict each other. The template is
                             declared inline and resolved by type: a bare ContentControl
                             has no template and renders the object's ToString(). -->
                        <StackPanel Spacing="{StaticResource SpaceXs}" IsVisible="{Binding !IsFanFullSpeedEnabled}">
                            <TextBlock Text="Fan Curve" Classes="FieldLabel" />
                            <ContentControl Content="{Binding FanCurve}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate x:DataType="dialogs:FanCurveViewModel">
                                        <StackPanel Spacing="{StaticResource SpaceXs}" IsVisible="{Binding IsSupported}">
                                            <ItemsControl ItemsSource="{Binding Points}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="dialogs:FanCurvePointViewModel">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,6">
                                                            <TextBlock Grid.Column="0" Text="{Binding TemperatureLabel}"
                                                                       MinWidth="48" VerticalAlignment="Center"
                                                                       FontSize="{StaticResource FontSizeXS}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                                       MinWidth="140" Margin="8,0" VerticalAlignment="Center"
                                                                       Opacity="{StaticResource OpacityMuted}"
                                                                       FontSize="{StaticResource FontSizeXS}" />
                                                            <StackPanel Grid.Column="2" Spacing="0">
                                                                <Slider Minimum="0" Maximum="{Binding MaxSpeedIndex}"
                                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        VerticalAlignment="Center"
                                                                        Value="{Binding SpeedIndex, Mode=TwoWay}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Classes="Chip" Margin="12,0,0,0"
                                                                    ToolTip.Tip="{Binding SpeedLabel, StringFormat='Curve target: {0}'}">
                                                                <TextBlock Classes="ChipText" Text="{Binding LiveSpeedLabel}"
                                                                           MinWidth="66" HorizontalAlignment="Left" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </StackPanel>

                        <TextBlock Classes="CardSubtitle"
                                   IsVisible="{Binding !IsFanFullSpeedSupported}"
                                   Text="Fan speed controls are not reported by this machine." />
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Advanced" Classes="SectionHeader" />
                        <TextBlock Classes="CardSubtitle"
                                   Text="Do not change options below unless you really know what you are doing." />
                        <ItemsControl ItemsSource="{Binding AdvancedSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:CustomModeSettingViewModel">
                                    <StackPanel Classes="FieldRow"
                                                IsVisible="{Binding IsSupported}">
                                        <TextBlock Text="{Binding Title}" Classes="FieldLabel" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Grid.Column="0"
                                                    Minimum="{Binding Minimum}"
                                                    Maximum="{Binding Maximum}"
                                                    TickFrequency="{Binding Step}"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Value, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Classes="FieldValue"
                                                       Text="{Binding ValueText}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
