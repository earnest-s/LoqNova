<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.NotificationsSettingsView"
             x:DataType="dialogs:NotificationsSettingsViewModel">

    <!-- Notifications settings, reproducing WPF's NotificationsSettingsWindow: the two
         master switches first, then the placement controls, then the per-event switches.
         Every switch applies immediately (there is no Save button); the detail rows are
         disabled while "Don't show notifications" is on. -->
    <Border Classes="DialogCard" Width="500" MaxHeight="620">
        <DockPanel Classes="DialogRoot" LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Classes="DialogHeader">
                <TextBlock Classes="DialogTitle" Text="{Binding Title}" />
            </StackPanel>

            <StackPanel Classes="DialogFooter" DockPanel.Dock="Bottom">
                <Button Classes="GhostButton" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource SpaceLg}">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="SettingHeader">
                            <TextBlock Classes="CardTitle" Text="Don't show notifications" />
                            <TextBlock Classes="CardSubtitle" TextWrapping="Wrap"
                                       Text="Disables notification for Fn keys actions like microphone mute.&#10;Enable this option if you have conflicts with full screen applications." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                      IsChecked="{Binding DontShowNotifications, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="SettingHeader">
                            <TextBlock Classes="CardTitle" Text="Notification always on top" />
                            <TextBlock Classes="CardSubtitle" TextWrapping="Wrap"
                                       Text="Always put notification at the top.&#10;It won't affect other full screen windows, but you will not be able to click on the notifications." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                      IsChecked="{Binding NotificationAlwaysOnTop, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="SettingHeader">
                            <TextBlock Classes="CardTitle" Text="Notification on all screens" />
                            <TextBlock Classes="CardSubtitle" TextWrapping="Wrap"
                                       Text="Show notification on all screens connected to your device." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                      IsChecked="{Binding NotificationOnAllScreens, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Spacing="{StaticResource SpaceLg}" IsEnabled="{Binding AreDetailsEnabled}">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Position" />
                            <ComboBox Grid.Column="1" Classes="Control SettingControl"
                                      ItemsSource="{Binding NotificationPositions}"
                                      SelectedValue="{Binding NotificationPosition, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="dialogs:NotificationPositionOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Duration" />
                            <ComboBox Grid.Column="1" Classes="Control SettingControl"
                                      ItemsSource="{Binding NotificationDurations}"
                                      SelectedValue="{Binding NotificationDuration, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Value}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="dialogs:NotificationDurationOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Updates" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding UpdateAvailable, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Actions" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding AutomationNotification, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Caps Lock and Num Lock" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding CapsNumLock, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Fn Lock" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding FnLock, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Touchpad Lock" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding TouchpadLock, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Smart Key" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding SmartKey, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Keyboard Backlight" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding KeyboardBacklight, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Camera" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding CameraLock, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Microphone" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding Microphone, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Power Mode" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding PowerMode, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Refresh Rate" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding RefreshRate, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="AC Adapter" />
                            <ToggleSwitch Grid.Column="1" Classes="Control SettingControl" OnContent="On" OffContent="Off"
                                          IsChecked="{Binding AcAdapter, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
