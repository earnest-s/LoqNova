<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.SelectSmartKeyPipelinesView"
             x:DataType="dialogs:SelectSmartKeyPipelinesViewModel">

    <!-- Smart Key Quick Action selector, reproducing WPF's
         SelectSmartKeyPipelinesWindow: "Show this app" plus the checkable pipeline list. -->
    <Border Classes="ContentCard" Width="400" MaxHeight="520">
        <DockPanel LastChildFill="True">

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Title}"
                       Classes="SectionHeader"
                       Margin="0,0,0,12" />

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Classes="GhostButton" Content="Cancel"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding CloseCommand}" />
                <Button Classes="PrimaryButton" Content="Save"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="12">

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="CardTitle"
                               Text="{Binding ShowThisAppTitle}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                  IsChecked="{Binding ShowThisApp, Mode=TwoWay}" />
                </Grid>

                <TextBlock Classes="CardSubtitle" TextWrapping="Wrap" Text="{Binding ListDescription}" />
            </StackPanel>

            <Border Classes="InsetPanel" IsEnabled="{Binding IsListEnabled}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Classes="CardSubtitle"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPipelines}"
                                   Text="{Binding EmptyMessage}" />

                        <ItemsControl ItemsSource="{Binding Pipelines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="dialogs:SmartKeyPipelineItem">
                                    <CheckBox Margin="0,0,0,8"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
