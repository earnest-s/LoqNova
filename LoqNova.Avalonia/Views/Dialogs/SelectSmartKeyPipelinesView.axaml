<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.SelectSmartKeyPipelinesView"
             x:DataType="dialogs:SelectSmartKeyPipelinesViewModel">

    <!-- Smart Key Quick Action selector, reproducing WPF's
         SelectSmartKeyPipelinesWindow: "Show this app" plus the checkable pipeline list. -->
    <Border Classes="DialogCard" Width="400" MaxHeight="520">
        <DockPanel Classes="DialogRoot" LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Classes="DialogHeader">
                <TextBlock Classes="DialogTitle" Text="{Binding Title}" />
            </StackPanel>

            <StackPanel Classes="DialogFooter" DockPanel.Dock="Bottom">
                <Button Classes="GhostButton" Content="Cancel"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding CloseCommand}" />
                <Button Classes="PrimaryButton" Content="Save"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource SpaceMd}" Margin="0,0,0,12">

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="SettingLabel"
                               Text="{Binding ShowThisAppTitle}" />
                    <ToggleSwitch Grid.Column="1" Classes="Control SettingControl"
                                  OnContent="On" OffContent="Off"
                                  IsChecked="{Binding ShowThisApp, Mode=TwoWay}" />
                </Grid>

                <TextBlock Classes="CardSubtitle" TextWrapping="Wrap" Text="{Binding ListDescription}" />
            </StackPanel>

            <Border Classes="InsetPanel" IsEnabled="{Binding IsListEnabled}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Classes="CardSubtitle"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPipelines}"
                                   Text="{Binding EmptyMessage}" />

                        <ItemsControl ItemsSource="{Binding Pipelines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="dialogs:SmartKeyPipelineItem">
                                    <CheckBox Classes="Control" Margin="0,0,0,8"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
