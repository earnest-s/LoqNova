<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.BootLogoView"
             x:DataType="dialogs:BootLogoViewModel">

    <!-- Boot logo, reproducing WPF's BootLogoWindow. The status line, the description of
         the required image size/formats and the success/failure message all come from the
         real BootLogo API. -->
    <Border Classes="DialogCard" Width="420">
        <StackPanel Classes="DialogBody">

            <TextBlock Classes="DialogTitle" Text="{Binding Title}" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="CardTitle" Text="{Binding StatusText}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="Chip" IsVisible="{Binding IsCustomLogoSet}">
                    <TextBlock Classes="ChipText" Text="{Binding CustomLogoSetText}" />
                </Border>
                <Border Grid.Column="1" Classes="Chip" IsVisible="{Binding IsDefaultLogoSet}">
                    <TextBlock Classes="ChipText" Text="{Binding DefaultLogoSetText}" />
                </Border>
            </Grid>

            <TextBlock Classes="DialogSubtitle" Text="{Binding Description}" />

            <TextBlock Classes="CalloutText"
                       TextAlignment="Center"
                       FontWeight="{StaticResource FontWeightMedium}"
                       Text="{Binding ResultMessage}"
                       Foreground="{Binding IsResultSuccess, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='SuccessBrush|DangerBrush'}" />

            <StackPanel Classes="DialogActions">
                <Button Classes="PrimaryButton" Content="{Binding RevertToDefaultText}"
                        IsVisible="{Binding IsCustomLogoSet}"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding RevertToDefaultCommand}" />
                <Button Classes="PrimaryButton" Content="{Binding CustomizeText}"
                        IsVisible="{Binding IsDefaultLogoSet}"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding CustomizeCommand}" />
                <Button Classes="GhostButton" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
