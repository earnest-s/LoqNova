<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.OverclockGpuSettingsView"
             x:DataType="dialogs:OverclockGpuSettingsViewModel">

    <!-- GPU overclock settings, reproducing WPF's
         OverclockDiscreteGPUSettingsWindow: a core and a memory frequency offset.
         Both are ranged from zero because that is the range the WPF sliders use. -->
    <Border Classes="DialogCard" Width="480" MaxHeight="560">
        <DockPanel Classes="DialogRoot" LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Classes="DialogHeader">
                <TextBlock Classes="DialogTitle" Text="GPU Overclock Settings" />
                <TextBlock Classes="DialogSubtitle"
                           Text="Increase performance by overclocking the discrete GPU." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Classes="DialogFooterBlock">
                <!-- One message, always the real one. A second hard-coded
                     "not supported" panel was shown alongside this one, and because
                     IsSupported starts false it appeared the instant the dialog
                     opened — before the backend had been asked anything — and it
                     stayed regardless of what the backend actually reported. -->
                <Border Classes="Callout Danger" Margin="0,0,0,8"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Classes="CalloutText" Text="{Binding ErrorMessage}" />
                </Border>

                <Border Classes="Callout Warning" Margin="0,0,0,8"
                        IsVisible="{Binding IsLoading}">
                    <TextBlock Classes="CalloutText"
                               Text="Reading the current overclock state from the machine..." />
                </Border>

                <StackPanel Classes="DialogActions">
                    <Button Classes="GhostButton" Content="Reset"
                            IsEnabled="{Binding IsSupported}"
                            Command="{Binding ResetDefaultsCommand}" />
                    <Button Classes="GhostButton" Content="Close"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding CloseCommand}" />
                    <Button Classes="PrimaryButton" Content="Apply"
                            IsEnabled="{Binding IsSupported}"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource SpaceLg}">

                    <StackPanel Classes="FieldRow">
                        <TextBlock Classes="FieldLabel" Text="Core Frequency Offset" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0"
                                    Minimum="0"
                                    Maximum="{Binding MaxCoreDelta}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsSupported}"
                                    Value="{Binding CoreClockOffset, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Classes="FieldValue"
                                       Text="{Binding CoreClockOffset, StringFormat='{}{0:+0;-0;0} MHz'}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Classes="FieldRow">
                        <TextBlock Classes="FieldLabel" Text="Memory Frequency Offset" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0"
                                    Minimum="0"
                                    Maximum="{Binding MaxMemoryDelta}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsSupported}"
                                    Value="{Binding MemoryClockOffset, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Classes="FieldValue"
                                       Text="{Binding MemoryClockOffset, StringFormat='{}{0:+0;-0;0} MHz'}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
