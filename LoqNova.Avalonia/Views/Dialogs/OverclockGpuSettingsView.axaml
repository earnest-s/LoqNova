<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.OverclockGpuSettingsView"
             x:DataType="dialogs:OverclockGpuSettingsViewModel">

    <!-- GPU overclock settings, reproducing WPF's
         OverclockDiscreteGPUSettingsWindow: a core and a memory frequency offset.
         Both are ranged from zero because that is the range the WPF sliders use. -->
    <Border Classes="ContentCard" Width="480" MaxHeight="560">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                <TextBlock Text="GPU Overclock Settings" Classes="SectionHeader" />
                <TextBlock Classes="CardSubtitle"
                           Text="Increase performance by overclocking the discrete GPU." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
                <!-- One message, always the real one. A second hard-coded
                     "not supported" panel was shown alongside this one, and because
                     IsSupported starts false it appeared the instant the dialog
                     opened — before the backend had been asked anything — and it
                     stayed regardless of what the backend actually reported. -->
                <Border Classes="InsetPanel" Padding="10" Margin="0,0,0,10"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="WidgetError" />
                </Border>

                <Border Classes="InsetPanel" Padding="10" Margin="0,0,0,10"
                        IsVisible="{Binding IsLoading}">
                    <TextBlock Text="Reading the current overclock state from the machine..."
                               TextWrapping="Wrap" Classes="WidgetWarning" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="GhostButton" Content="Reset"
                            IsEnabled="{Binding IsSupported}"
                            Command="{Binding ResetDefaultsCommand}" />
                    <Button Classes="GhostButton" Content="Close"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding CloseCommand}" />
                    <Button Classes="PrimaryButton" Content="Apply"
                            IsEnabled="{Binding IsSupported}"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,16,0" Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Core Frequency Offset" FontSize="12" Opacity="0.8" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0"
                                    Minimum="0"
                                    Maximum="{Binding MaxCoreDelta}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsSupported}"
                                    Value="{Binding CoreClockOffset, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" MinWidth="80" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Text="{Binding CoreClockOffset, StringFormat='{}{0:+0;-0;0} MHz'}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Memory Frequency Offset" FontSize="12" Opacity="0.8" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0"
                                    Minimum="0"
                                    Maximum="{Binding MaxMemoryDelta}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsSupported}"
                                    Value="{Binding MemoryClockOffset, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" MinWidth="80" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Text="{Binding MemoryClockOffset, StringFormat='{}{0:+0;-0;0} MHz'}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
