<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.BalanceModeSettingsView"
             x:DataType="dialogs:BalanceModeSettingsViewModel">

    <!-- Balance Mode settings, reproducing WPF's BalanceModeSettingsWindow: one
         control, the AI Engine toggle, which maps to AIController.IsAIModeEnabled. -->
    <Border Classes="DialogCard" Width="440">
        <StackPanel Classes="DialogBody">

            <TextBlock Classes="DialogTitle" Text="Balance Mode Settings" />

            <TextBlock Classes="DialogSubtitle"
                       Text="Automatically detects when certain games are running and tweaks CPU and GPU performance. Temperatures and fan noise might increase." />

            <CheckBox Name="AiEngineToggle"
                      Classes="Control"
                      Content="Enable AI Engine"
                      IsEnabled="{Binding !IsBusy}"
                      IsChecked="{Binding AiEngineEnabled, Mode=TwoWay}" />

            <Border Classes="Callout Danger"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                <TextBlock Classes="CalloutText" Text="{Binding ErrorMessage}" />
            </Border>

            <TextBlock Classes="DialogSubtitle"
                       IsVisible="{Binding !IsSupported}"
                       Text="This machine does not report the AI Chip capability, so the AI Engine is unavailable." />

            <StackPanel Classes="DialogActions">
                <Button Classes="GhostButton" Content="Cancel"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding CloseCommand}" />
                <Button Classes="PrimaryButton" Content="Save"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
