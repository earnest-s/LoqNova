<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:LoqNova.Avalonia.ViewModels.Dialogs"
             x:Class="LoqNova.Avalonia.Views.Dialogs.FanCurveView"
             x:DataType="dialogs:FanCurveViewModel">

    <!-- Fan curve, reproducing WPF's FanCurveControl: a slider per temperature point,
         each choosing a step from that point's fan speeds. -->
    <StackPanel Spacing="8" IsVisible="{Binding IsSupported}">
        <ItemsControl ItemsSource="{Binding Points}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dialogs:FanCurvePointViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TemperatureLabel}"
                                   MinWidth="52"
                                   VerticalAlignment="Center"
                                   FontSize="11" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Description}"
                                   MinWidth="150"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.7"
                                   FontSize="11" />
                        <Slider Grid.Column="2"
                                Minimum="0"
                                Maximum="{Binding StepCount}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Value="{Binding SpeedIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SpeedLabel}"
                                   MinWidth="80"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontSize="11" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
