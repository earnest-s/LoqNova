<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels"
        xmlns:notifications="clr-namespace:LoqNova.Avalonia.Views.Controls.Notifications"
        x:Class="LoqNova.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="LOQ Nova"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="avares://LOQ Nova/Assets/icon.ico"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- One navigation item template, shared by the primary list and the
             footer list so both render identically.
             Selection is expressed with IsVisible rather than converter
             parameters: "|" inside a ConverterParameter is parsed by Avalonia
             as the multi-binding operator, which silently breaks the binding. -->
        <DataTemplate x:Key="NavigationItemTemplate">
            <Button Classes="NavItem"
                    Background="Transparent"
                    Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                    CommandParameter="{Binding Page}"
                    IsVisible="{Binding IsVisible}">
                <Grid>
                    <!-- Base plate: the Fluent Button template paints its own
                         background, so every row gets an explicit plate to keep
                         the sidebar visually flat and controlled. -->
                    <Border Classes="NavItemPlate" />
                    <!-- Selected plate -->
                    <Border Classes="NavItemPlateSelected" IsVisible="{Binding IsSelected}" />
                    <!-- Selected accent rail -->
                    <Border Classes="NavRail" IsVisible="{Binding IsSelected}" />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" Margin="14,0,0,0">
                        <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                            <PathIcon Classes="NavIcon"
                                      Data="{Binding Icon, Converter={StaticResource IconNameToGeometryConverter}}"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                            <PathIcon Classes="NavIcon NavIconActive"
                                      IsVisible="{Binding IsSelected}"
                                      Data="{Binding Icon, Converter={StaticResource IconNameToGeometryConverter}}"
                                      Foreground="{StaticResource PrimaryBrush}" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="{Binding Label}" Classes="NavItemLabel" />
                            <TextBlock Text="{Binding Label}"
                                       Classes="NavItemLabel NavItemLabelActive"
                                       IsVisible="{Binding IsSelected}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Panel>
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">

            <!-- ============================ Title bar ============================ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="TitleBar">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Image Source="avares://LOQ Nova/Assets/icon.ico" Width="15" Height="15" />
                        <TextBlock Text="LOQ Nova" Classes="TitleBarText" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="CaptionButton" ToolTip.Tip="Minimize" Command="{Binding MinimizeCommand}">
                            <PathIcon Data="M0 10h24" Width="11" Height="11"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Classes="CaptionButton" ToolTip.Tip="Maximize" Command="{Binding ToggleMaximizeCommand}">
                            <PathIcon Data="M4 4h16v16H4z" Width="11" Height="11"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Classes="CaptionButton CaptionClose" ToolTip.Tip="Close" Command="{Binding CloseCommand}">
                            <PathIcon Data="M18 6L6 18M6 6l12 12" Width="11" Height="11"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Body ============================ -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">

                <!-- ==================== Single primary sidebar ==================== -->
                <Border Grid.Column="0" Classes="NavSidebar">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Brand + device identity -->
                        <StackPanel Grid.Row="0" Margin="18,18,18,14" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                                <Image Source="avares://LOQ Nova/Assets/icon.ico" Width="26" Height="26"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="LOQ Nova" Classes="NavBrand" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceModel}" Classes="NavBrandMeta" Margin="38,2,0,0" />
                            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                       Classes="NavBrandMeta" Margin="38,0,0,0" />
                        </StackPanel>

                        <!-- Primary destinations -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}"
                                          ItemTemplate="{StaticResource NavigationItemTemplate}" />
                        </ScrollViewer>

                        <!-- Settings + About, pinned to the bottom -->
                        <Border Grid.Row="2" Classes="NavFooterPlate">
                            <StackPanel>
                                <Separator Classes="NavSeparator" Margin="10,0" />
                                <ItemsControl ItemsSource="{Binding FooterNavigationItems}"
                                              ItemTemplate="{StaticResource NavigationItemTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Page host -->
                <ContentControl Grid.Column="1" x:Name="ContentHost" />
            </Grid>
        </Grid>

        <notifications:SnackbarHost x:Name="SnackbarHost"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Margin="24" />
    </Panel>
</Window>
