<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="LoqNova.Avalonia.Views.MainWindow"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        Title="LOQ Nova"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="#0D0E11" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Phase 1 placeholder title bar. Replaced by custom chrome in Phase 2. -->
        <Border DockPanel.Dock="Top" Height="44" Background="#16181D">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="14" FontWeight="SemiBold" Foreground="#E6E6E6"
                           Text="LOQ Nova" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,12,0" FontSize="11" Foreground="#8A8F98"
                           Text="Phase 1  ·  Avalonia Shell" />
            </Grid>
        </Border>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#D8DAE0"
                           Text="LOQ Nova  ·  Avalonia" />
                <TextBlock FontSize="13" Foreground="#8A8F98" HorizontalAlignment="Center"
                           Text="Backend initialized. Dashboard arrives in Phase 4." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
