<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             xmlns:services="clr-namespace:LoqNova.Avalonia.Services"
             xmlns:controls="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Pages.KeyboardBacklightPage"
             x:DataType="vm:KeyboardBacklightViewModel">

    <Design.DataContext>
        <vm:KeyboardBacklightViewModel />
    </Design.DataContext>

    <ScrollViewer Classes="PageContainer">
        <StackPanel Spacing="24">
            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Keyboard Backlight" Classes="PageTitle" />
                <Button Classes="GhostButton" Content="Spectrum" IsVisible="{Binding IsSpectrumKeyboard}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Keyboard Preview -->
            <Border Classes="ContentCard" HorizontalAlignment="Center">
                <!-- Preview colours follow RgbFrameDispatcher.FrameRendered, so they
                     represent what the keyboard is actually showing. There is no
                     brightness control here: the Brightness card below is the single
                     authoritative one. -->
                <controls:KeyboardPreviewControl Zone1Color="{Binding PreviewZone1}"
                                                 Zone2Color="{Binding PreviewZone2}"
                                                 Zone3Color="{Binding PreviewZone3}"
                                                 Zone4Color="{Binding PreviewZone4}" />
            </Border>

            <!-- Presets -->
            <Border Classes="ContentCard">
                <StackPanel>
                    <TextBlock Text="Presets" Classes="SectionHeader" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="PresetButton" Content="Off" IsEnabled="{Binding IsInteractive}"
                                Command="{Binding SetPresetCommand}" CommandParameter="{x:Static services:RgbPreset.Off}" />
                        <Button Classes="PresetButton" Content="Preset 1" IsEnabled="{Binding IsInteractive}"
                                Command="{Binding SetPresetCommand}" CommandParameter="{x:Static services:RgbPreset.Preset1}" />
                        <Button Classes="PresetButton" Content="Preset 2" IsEnabled="{Binding IsInteractive}"
                                Command="{Binding SetPresetCommand}" CommandParameter="{x:Static services:RgbPreset.Preset2}" />
                        <Button Classes="PresetButton" Content="Preset 3" IsEnabled="{Binding IsInteractive}"
                                Command="{Binding SetPresetCommand}" CommandParameter="{x:Static services:RgbPreset.Preset3}" />
                        <Button Classes="PresetButton" Content="Preset 4" IsEnabled="{Binding IsInteractive}"
                                Command="{Binding SetPresetCommand}" CommandParameter="{x:Static services:RgbPreset.Preset4}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Brightness: the only brightness control on the page -->
            <Border Classes="ContentCard">
                <StackPanel>
                    <TextBlock Text="Brightness" Classes="SectionHeader" />
                    <ComboBox ItemsSource="{Binding BrightnessLevels}"
                              SelectedItem="{Binding SelectedBrightness, Mode=TwoWay}"
                              IsEnabled="{Binding IsInteractive}"
                              Width="150"
                              Margin="0,8,0,0"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Effects: one combined list, firmware and software effects together -->
            <Border Classes="ContentCard">
                <StackPanel>
                    <TextBlock Text="Effects" Classes="SectionHeader" />
                    <ComboBox ItemsSource="{Binding Effects}"
                              SelectedItem="{Binding SelectedEffect, Mode=TwoWay}"
                              IsEnabled="{Binding IsInteractive}"
                              Width="220"
                              Margin="0,8,0,0"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Speed: only shown for effects the backend reports as supporting speed -->
            <Border Classes="ContentCard" IsVisible="{Binding SpeedEnabled}">
                <StackPanel>
                    <TextBlock Text="Speed" Classes="SectionHeader" />
                    <ComboBox ItemsSource="{Binding Speeds}"
                              SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"
                              IsEnabled="{Binding IsInteractive}"
                              Width="150"
                              Margin="0,8,0,0"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Zone Colors -->
            <Border Classes="ContentCard" IsVisible="{Binding ZonesEnabled}">
                <StackPanel>
                    <TextBlock Text="Zone Colors" Classes="SectionHeader" />

                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,16,0,0">
                        <controls:ZoneColorPicker Grid.Column="0" ZoneNumber="1" Color="{Binding Zone1Color, Mode=TwoWay}" />
                        <controls:ZoneColorPicker Grid.Column="1" ZoneNumber="2" Color="{Binding Zone2Color, Mode=TwoWay}" />
                        <controls:ZoneColorPicker Grid.Column="2" ZoneNumber="3" Color="{Binding Zone3Color, Mode=TwoWay}" />
                        <controls:ZoneColorPicker Grid.Column="3" ZoneNumber="4" Color="{Binding Zone4Color, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
