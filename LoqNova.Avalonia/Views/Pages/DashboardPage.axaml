<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             xmlns:vmControls="clr-namespace:LoqNova.Avalonia.ViewModels.Controls"
             xmlns:controls="clr-namespace:LoqNova.Avalonia.Views.Controls"
             xmlns:dash="clr-namespace:LoqNova.Avalonia.Views.Controls.Dashboard"
             x:Class="LoqNova.Avalonia.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <ScrollViewer Classes="PageContainer" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="PageBody">

            <!-- ============================ Page header ============================ -->
            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Classes="PageTitle" />
                    <TextBlock Text="Live hardware control and telemetry" Classes="PageSubtitle" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                            VerticalAlignment="Center">
                    <Button Classes="SecondaryButton"
                            Content="Edit Dashboard"
                            Command="{Binding EditDashboardCommand}" />
                    <Button Classes="PrimaryButton"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- ============================ Power mode ============================ -->
            <Border Classes="PowerCard">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Accent rail carries the active mode colour -->
                    <Border Grid.Column="0" Classes="PowerAccent" Background="{Binding PowerModeColor}" />

                    <!-- Current mode readout -->
                    <StackPanel Grid.Column="1"
                                Margin="16"
                                VerticalAlignment="Center">
                        <TextBlock Text="Power mode" Classes="SectionLabel" Margin="0" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                            <Border Width="10" Height="10" CornerRadius="{StaticResource RadiusMdBox}"
                                    Background="{Binding PowerModeColor}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPowerMode, Converter={StaticResource PowerModeDisplayNameConverter}}"
                                       Classes="PowerModeValue"
                                       Foreground="{Binding PowerModeColor}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mode selector. The backend enum is PowerModeState.GodMode;
                         it is presented as "Custom Mode" to match the WPF resource
                         strings. The selection is OneWay so the combo reflects the
                         authoritative VM state and can never write back a null it
                         produces while ItemsSource is being populated; user changes
                         are routed through the explicit handler below. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <ComboBox Classes="Control"
                                  Width="200"
                                  SelectionChanged="OnPowerModeSelectionChanged"
                                  ItemsSource="{Binding PowerModeItems}"
                                  SelectedItem="{Binding CurrentPowerMode, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PowerModeDisplayNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- WPF shows a settings button beside the mode selector for
                             Balance (AI Engine) and Custom Mode (the limits), and
                             hides it otherwise. The same gating applies here, so the
                             button is only offered where there is real settings. -->
                        <Button Classes="IconButton"
                                ToolTip.Tip="Open the settings for this mode"
                                IsVisible="{Binding HasPowerModeSettings}"
                                Command="{Binding OpenPowerModeSettingsCommand}">
                            <PathIcon Data="{Binding SettingsIcon, Converter={StaticResource IconNameToGeometryConverter}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Monitoring ============================ -->
            <TextBlock Text="Monitoring" Classes="SectionLabel" Margin="0" />

            <!-- The machine's sensor source gate. When it reports no supported
                 source, every reading below stays blank rather than showing a
                 plausible-looking number. -->
            <Border Classes="Callout Warning" IsVisible="{Binding !IsSensorsSupported}">
                <TextBlock Classes="CalloutText"
                           Text="This machine reports no supported sensor source, so live readings are unavailable." />
            </Border>

            <!-- The instrument cluster. Two device instruments that reflow from
                 side by side to stacked as the window narrows, each drawing the
                 same layout so CPU and GPU read as matching parts of one cluster.

                 Every value comes from the reported telemetry: ClusterGauge
                 sweeps utilisation over the reported maximum, TemperatureGauge
                 fills against the reported maximum, and AnalogFanControl turns
                 at the reported RPM. An unreported channel draws muted and blank
                 rather than as a zero. -->
            <controls:ResponsiveUniformGrid ItemWidth="420" MaxColumns="2">

                <!-- ==================== CPU instrument ==================== -->
                <Border Grid.Column="0" Classes="InstrumentCard" Margin="0,0,12,12">
                    <StackPanel Spacing="{StaticResource SpaceXl}">

                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="DeviceAccent"
                                    Background="{DynamicResource SensorCpuBrush}" />
                            <TextBlock Grid.Column="1" Classes="DeviceTitle" Text="CPU" Margin="10,0,0,0" />
                        </Grid>

                        <!-- Utilisation dial, temperature bar and the clock readouts. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceSm}">
                                <dash:ClusterGauge Width="196" Height="196"
                                                   Value="{Binding CpuUtilization}"
                                                   Maximum="{Binding CpuMaxUtilization}"
                                                   ValueText="{Binding CpuUtilizationText}"
                                                   Unit="%"
                                                   Accent="{DynamicResource SensorCpuBrush}" />
                                <TextBlock Classes="InstrumentCaption" Text="Utilization"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0"
                                        Spacing="{StaticResource SpaceMd}"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="InstrumentCaption" Text="Temperature" />
                                <dash:TemperatureGauge Height="34"
                                                       Value="{Binding CpuTemperature}"
                                                       Maximum="{Binding CpuMaxTemperature}"
                                                       ValueText="{Binding CpuTemperatureText}"
                                                       Unit="{Binding TemperatureUnitLabel}" />

                                <Border Classes="CardDivider" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="TelemetryLabel" Text="Core clock" />
                                    <TextBlock Grid.Column="1" Classes="TelemetryValue" Text="{Binding CpuCoreClockText}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="TelemetryLabel" Text="Maximum clock" />
                                    <TextBlock Grid.Column="1" Classes="TelemetryValue" Text="{Binding CpuCoreClockMaxText}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Classes="CardDivider" />

                        <!-- The fan dial turns at the reported speed; the column
                             beside it prints that same reading, the reported
                             maximum and the restrained qualitative state. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <dash:AnalogFanControl Grid.Column="0" Width="132" Height="132"
                                                   Rpm="{Binding CpuFanSpeed}"
                                                   MaxRpm="{Binding CpuMaxFanSpeed}"
                                                   Accent="{DynamicResource SensorFanBrush}" />

                            <StackPanel Grid.Column="1" Margin="18,0,0,0"
                                        Spacing="{StaticResource SpaceSm}"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="InstrumentCaption" Text="Fan" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Classes="FanValue" Text="{Binding CpuFanSpeedText}" />
                                    <TextBlock Classes="FanUnit" Text="RPM"
                                               IsVisible="{Binding IsCpuFanReported}" />
                                </StackPanel>
                                <TextBlock Classes="InstrumentMeta" Text="{Binding CpuFanSpeedMaxText}"
                                           IsVisible="{Binding CpuFanSpeedMaxText, Converter={StaticResource StringNotEmptyConverter}}" />
                                <Border Classes="Chip" HorizontalAlignment="Left"
                                        IsVisible="{Binding CpuFanStateText, Converter={StaticResource StringNotEmptyConverter}}">
                                    <TextBlock Classes="ChipText" Text="{Binding CpuFanStateText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== GPU instrument ==================== -->
                <Border Classes="InstrumentCard" Margin="0,0,12,12">
                    <StackPanel Spacing="{StaticResource SpaceXl}">

                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="DeviceAccent"
                                    Background="{DynamicResource SensorGpuBrush}" />
                            <TextBlock Grid.Column="1" Classes="DeviceTitle" Text="GPU" Margin="10,0,0,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceSm}">
                                <dash:ClusterGauge Width="196" Height="196"
                                                   Value="{Binding GpuUtilization}"
                                                   Maximum="{Binding GpuMaxUtilization}"
                                                   ValueText="{Binding GpuUtilizationText}"
                                                   Unit="%"
                                                   Accent="{DynamicResource SensorGpuBrush}" />
                                <TextBlock Classes="InstrumentCaption" Text="Utilization"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0"
                                        Spacing="{StaticResource SpaceMd}"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="InstrumentCaption" Text="Temperature" />
                                <dash:TemperatureGauge Height="34"
                                                       Value="{Binding GpuTemperature}"
                                                       Maximum="{Binding GpuMaxTemperature}"
                                                       ValueText="{Binding GpuTemperatureText}"
                                                       Unit="{Binding TemperatureUnitLabel}" />

                                <Border Classes="CardDivider" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="TelemetryLabel" Text="Core clock" />
                                    <TextBlock Grid.Column="1" Classes="TelemetryValue" Text="{Binding GpuCoreClockText}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="TelemetryLabel" Text="Memory clock" />
                                    <TextBlock Grid.Column="1" Classes="TelemetryValue" Text="{Binding GpuMemoryClockText}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Classes="CardDivider" />

                        <Grid ColumnDefinitions="Auto,*">
                            <dash:AnalogFanControl Grid.Column="0" Width="132" Height="132"
                                                   Rpm="{Binding GpuFanSpeed}"
                                                   MaxRpm="{Binding GpuMaxFanSpeed}"
                                                   Accent="{DynamicResource SensorFanBrush}" />

                            <StackPanel Grid.Column="1" Margin="18,0,0,0"
                                        Spacing="{StaticResource SpaceSm}"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="InstrumentCaption" Text="Fan" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Classes="FanValue" Text="{Binding GpuFanSpeedText}" />
                                    <TextBlock Classes="FanUnit" Text="RPM"
                                               IsVisible="{Binding IsGpuFanReported}" />
                                </StackPanel>
                                <TextBlock Classes="InstrumentMeta" Text="{Binding GpuFanSpeedMaxText}"
                                           IsVisible="{Binding GpuFanSpeedMaxText, Converter={StaticResource StringNotEmptyConverter}}" />
                                <Border Classes="Chip" HorizontalAlignment="Left"
                                        IsVisible="{Binding GpuFanStateText, Converter={StaticResource StringNotEmptyConverter}}">
                                    <TextBlock Classes="ChipText" Text="{Binding GpuFanStateText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </controls:ResponsiveUniformGrid>

            <!-- ============================ Quick controls ============================ -->
            <TextBlock Text="Quick controls" Classes="SectionLabel" Margin="0" />

            <ItemsControl ItemsSource="{Binding ControlWidgets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- The grid reflows to the available width instead of
                             reserving dead space. -->
                        <controls:ResponsiveUniformGrid ItemWidth="232" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmControls:FeatureWidgetViewModel">
                        <Border Classes="WidgetCard ControlTile" Margin="0,0,12,12">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0"
                                              Classes="SensorIcon"
                                              VerticalAlignment="Center"
                                              Data="{Binding Icon, Converter={StaticResource IconNameToGeometryConverter}}"
                                              Foreground="{DynamicResource TextMutedBrush}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Classes="WidgetTitle"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Two-state feature (or GPU overclock): writes through the backend. -->
                                <ToggleSwitch Classes="Control"
                                              IsVisible="{Binding IsToggle}"
                                              IsEnabled="{Binding !IsBusy}"
                                              Click="OnWidgetToggleClicked"
                                              IsChecked="{Binding IsOn, Mode=OneWay}" />

                                <!-- Multi-state feature: options are read from the machine. -->
                                <ComboBox Classes="Control"
                                          IsVisible="{Binding IsChoice}"
                                          IsEnabled="{Binding !IsBusy}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnWidgetSelectionChanged"
                                          ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding SelectedState, Mode=OneWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Library state types implementing IDisplayName supply
                                                 their own text (Resolution, RefreshRate). -->
                                            <TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Read-only state, e.g. discrete GPU status. -->
                                <TextBlock Text="{Binding StatusText}"
                                           Classes="WidgetValue"
                                           IsVisible="{Binding IsStatus}" />

                                <!-- WPF's dashboard cards carry a settings button
                                     beside the control for features with a detail
                                     window: GPU overclock here, power mode settings
                                     on the power-mode selector above. -->
                                <Button Classes="IconButton"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        ToolTip.Tip="Open settings for this feature"
                                        IsVisible="{Binding HasSettingsDialog}"
                                        Command="{Binding OpenSettingsCommand}">
                                    <PathIcon Data="{Binding SettingsIcon, Converter={StaticResource IconNameToGeometryConverter}}" />
                                </Button>

                                <!-- Feature actions, e.g. restart or apply. -->
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                                            IsVisible="{Binding HasPrimaryAction}">
                                    <Button Classes="SecondaryButton"
                                            Content="{Binding PrimaryActionText}"
                                            IsEnabled="{Binding !IsBusy}"
                                            Command="{Binding PrimaryActionCommand}" />
                                    <Button Classes="SecondaryButton"
                                            Content="{Binding SecondaryActionText}"
                                            IsVisible="{Binding HasSecondaryAction}"
                                            IsEnabled="{Binding !IsBusy}"
                                            Command="{Binding SecondaryActionCommand}" />
                                </StackPanel>

                                <!-- Feature feedback: a warning or error the feature
                                     reported, never a fabricated message. -->
                                <TextBlock Classes="WidgetWarning"
                                           Text="{Binding Warning}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding Warning, Converter={StaticResource StringNotEmptyConverter}}" />
                                <TextBlock Classes="WidgetError"
                                           Text="{Binding ErrorMessage}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
