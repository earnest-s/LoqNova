<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             xmlns:vmControls="clr-namespace:LoqNova.Avalonia.ViewModels.Controls"
             xmlns:controls="clr-namespace:LoqNova.Avalonia.Views.Controls"
             xmlns:sensors="clr-namespace:LoqNova.Avalonia.Views.Controls.Sensors"
             x:Class="LoqNova.Avalonia.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <ScrollViewer Classes="PageContainer" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="PageBody">

            <!-- ============================ Page header ============================ -->
            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Classes="PageTitle" />
                    <TextBlock Text="System telemetry and control overview"
                               Classes="PageSubtitle" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                            VerticalAlignment="Center">
                    <Button Classes="SecondaryButton"
                            Content="Edit Dashboard"
                            Command="{Binding EditDashboardCommand}" />
                    <Button Classes="PrimaryButton"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- ============================ Power mode ============================ -->
            <Border Classes="PowerCard">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Accent rail carries the active mode colour -->
                    <Border Grid.Column="0" Classes="PowerAccent" Background="{Binding PowerModeColor}" />

                    <!-- Current mode readout -->
                    <StackPanel Grid.Column="1"
                                Margin="16"
                                VerticalAlignment="Center">
                        <TextBlock Text="Power mode" Classes="SectionLabel" Margin="0" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{Binding PowerModeColor}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPowerMode}"
                                       Classes="PowerModeValue"
                                       Foreground="{Binding PowerModeColor}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mode selector + God Mode -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                                VerticalAlignment="Center">
                        <ComboBox Classes="Control"
                                  Width="200"
                                  ItemsSource="{Binding PowerModeItems}"
                                  SelectedItem="{Binding CurrentPowerMode}" />
                        <Button Classes="SecondaryButton"
                                Content="God Mode"
                                Command="{Binding OpenGodModeCommand}"
                                IsVisible="{Binding IsGodModeSupported}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Monitoring ============================ -->
            <TextBlock Text="Monitoring" Classes="SectionLabel" />

            <sensors:SensorsPanel CpuUsage="{Binding CpuUsage}"
                                   GpuUsage="{Binding GpuUsage}"
                                   CpuTemperature="{Binding CpuTemperature}"
                                   GpuTemperature="{Binding GpuTemperature}"
                                   FanSpeedRpm="{Binding FanSpeedRpm}"
                                   FanSpeedPercent="{Binding FanSpeedPercent}"
                                   PowerModeColor="{Binding PowerModeColor}" />

            <!-- ============================ Quick controls ============================ -->
            <TextBlock Text="Quick controls" Classes="SectionLabel" Margin="0,4,0,0" />

            <ItemsControl ItemsSource="{Binding ControlWidgets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Column count follows the available width, so the
                             grid reflows instead of reserving dead space. -->
                        <controls:ResponsiveUniformGrid ItemWidth="232" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmControls:FeatureWidgetViewModel">
                        <Border Classes="WidgetCard" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <PathIcon Grid.Row="0" Grid.Column="0"
                                          Classes="SensorIcon"
                                          VerticalAlignment="Center"
                                          Data="{Binding Icon, Converter={StaticResource IconNameToGeometryConverter}}"
                                          Foreground="{StaticResource TextMutedBrush}" />

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Title}"
                                           Classes="WidgetTitle"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />

                                <!-- Two-state feature: writes through the library feature. -->
                                <ToggleSwitch Grid.Row="1" Grid.ColumnSpan="2"
                                              Margin="0,10,0,0"
                                              IsVisible="{Binding IsToggle}"
                                              IsEnabled="{Binding !IsBusy}"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}" />

                                <!-- Multi-state feature: options come from the machine. -->
                                <ComboBox Grid.Row="1" Grid.ColumnSpan="2"
                                          Margin="0,10,0,0"
                                          IsVisible="{Binding IsChoice}"
                                          IsEnabled="{Binding !IsBusy}"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding SelectedState, Mode=TwoWay}" />

                                <!-- Advisory text, mirroring WPF's Warning on the card header. -->
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding Warning}"
                                           Classes="WidgetWarning"
                                           Margin="0,6,0,0"
                                           IsVisible="{Binding Warning, Converter={StaticResource StringNotEmptyConverter}}" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding ErrorMessage}"
                                           Classes="WidgetError"
                                           Margin="0,6,0,0"
                                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
