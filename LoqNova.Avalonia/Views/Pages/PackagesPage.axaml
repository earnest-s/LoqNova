<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             x:Class="LoqNova.Avalonia.Views.Pages.PackagesPage"
             x:DataType="vm:PackagesViewModel">

    <Design.DataContext>
        <vm:PackagesViewModel />
    </Design.DataContext>

    <ScrollViewer Classes="PageContainer">
        <StackPanel Classes="PageBody">

            <!-- ============================ Header ============================ -->
            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Classes="PageTitle" />
                    <TextBlock Text="{Binding DisclaimerMessage}" Classes="PageSubtitle"
                               TextWrapping="Wrap" MaxWidth="620" />
                </StackPanel>
            </Grid>

            <!-- ============================ Configuration ============================ -->
            <Border Classes="ContentCard">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">

                    <!-- ==================== Left: inputs ==================== -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Machine type -->
                        <TextBlock Grid.Row="0" Text="{Binding MachineTypeLabel}"
                                   Classes="SectionLabel" Margin="0,0,0,6" />
                        <TextBox Grid.Row="1" Classes="Control" MaxWidth="180" HorizontalAlignment="Left"
                                 Text="{Binding MachineType, Mode=TwoWay}"
                                 Watermark="(eg. 82JQ)"
                                 IsEnabled="{Binding !IsLoading}"
                                 Margin="0,0,0,14" />

                        <!-- Operating system -->
                        <TextBlock Grid.Row="2" Text="{Binding OperatingSystemLabel}"
                                   Classes="SectionLabel" Margin="0,0,0,6" />
                        <ComboBox Grid.Row="3" Classes="Control" MaxWidth="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding OperatingSystems}"
                                  SelectedItem="{Binding OperatingSystem, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsLoading}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Download folder -->
                        <TextBlock Grid.Row="4" Text="{Binding DownloadToLabel}"
                                   Classes="SectionLabel" Margin="0,16,0,6" />
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                            <TextBox Classes="Control" Width="330"
                                     Text="{Binding DownloadPath, Mode=TwoWay}" />
                            <Button Classes="SecondaryButton" Content="{Binding BrowseLabel}"
                                    Command="{Binding BrowseDownloadPathCommand}"
                                    IsEnabled="{Binding !IsLoading}" />
                            <Button Classes="SecondaryButton" Content="{Binding OpenDownloadToLabel}"
                                    Command="{Binding OpenDownloadLocationCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- ==================== Right: source + actions ==================== -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" MinWidth="260">
                        <TextBlock Grid.Row="0" Text="{Binding SourceLabel}" Classes="SectionLabel" />

                        <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceSm}" Margin="0,0,0,16">
                            <RadioButton Classes="Control" GroupName="packageSource"
                                         IsChecked="{Binding IsVantageSource, Mode=TwoWay}"
                                         IsEnabled="{Binding !IsLoading}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PrimarySourceLabel}" />
                                    <TextBlock Text="{Binding PrimarySourceMessage}" Classes="Caption" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="Control" GroupName="packageSource"
                                         IsChecked="{Binding IsPCSupportSource, Mode=TwoWay}"
                                         IsEnabled="{Binding !IsLoading}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SecondarySourceLabel}" />
                                    <TextBlock Text="{Binding SecondarySourceMessage}" Classes="Caption" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                                    HorizontalAlignment="Right">
                            <Button Classes="PrimaryButton" Content="{Binding RefreshLabel}"
                                    Command="{Binding DownloadPackagesCommand}"
                                    IsEnabled="{Binding !IsLoading}" />
                            <Button Classes="SecondaryButton" Content="{Binding CancelLabel}"
                                    Command="{Binding CancelDownloadPackagesCommand}"
                                    IsVisible="{Binding IsCancelVisible}" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <!-- ============================ Retrieval progress ============================ -->
            <Border Classes="InsetPanel" IsVisible="{Binding IsLoading}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="{Binding PageTitle}" Classes="SectionLabel" Margin="0" />
                    <ProgressBar Classes="Metric"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Value="{Binding Progress}" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- ============================ Filters ============================ -->
            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,4">
                <TextBox Grid.Column="0" Classes="Control" Width="240"
                         Text="{Binding FilterText, Mode=TwoWay}"
                         Watermark="{Binding FilterLabel}" />

                <CheckBox Grid.Column="1" Classes="Control" Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Content="{Binding OnlyShowUpdatesLabel}"
                          IsVisible="{Binding IsOnlyShowUpdatesVisible}"
                          IsChecked="{Binding OnlyShowUpdates, Mode=TwoWay}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SortLabel}" Classes="SectionLabel"
                               VerticalAlignment="Center" Margin="0" />
                    <ComboBox Classes="Control" Width="160"
                              ItemsSource="{Binding SortLabels}"
                              SelectedIndex="{Binding SortIndex, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- ============================ Package list ============================ -->
            <ItemsControl ItemsSource="{Binding Packages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageViewModel">
                        <Border Classes="FeatureCard" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">

                                <!-- Update / status rail -->
                                <Border Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="{StaticResource PrimaryMutedBrush}" />

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">

                                    <!-- Title row -->
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <TextBlock Text="{Binding Title}" Classes="CardValue" />
                                        <Border Classes="InsetPanel" Padding="8,2"
                                                IsVisible="{Binding IsUpdate}">
                                            <TextBlock Text="{Binding IsUpdateLabel}" Classes="Caption"
                                                       Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                        <Border Classes="InsetPanel" Padding="8,2"
                                                IsVisible="{Binding IsOld}">
                                            <TextBlock Text="{Binding OldPackageWarning}" Classes="Caption" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Category + date -->
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <TextBlock Text="{Binding Category}" Classes="Caption"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding ReleaseDateText}" Classes="Caption" />
                                        <TextBlock Text="{Binding RebootText}" Classes="Caption"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   IsVisible="{Binding HasRebootWarning}" />
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" Classes="BodySmall"
                                               TextWrapping="Wrap" MaxWidth="620"
                                               IsVisible="{Binding HasDescription}" />

                                    <!-- Version / size / file -->
                                    <TextBlock Text="{Binding DetailText}" Classes="Caption" />

                                    <!-- Per package progress -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsDownloading}">
                                        <ProgressBar Classes="Metric"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Value="{Binding Progress}" Maximum="100"
                                                     Width="280" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                   Classes="Caption" />
                                    </StackPanel>

                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}"
                                            VerticalAlignment="Center">
                                    <Button Classes="GhostButton" Content="{Binding ReadmeLabel}"
                                            Command="{Binding OpenReadmeCommand}"
                                            IsVisible="{Binding HasReadme}" />
                                    <Button Classes="GhostButton" Content="{Binding HideLabel}"
                                            Command="{Binding $parent[UserControl].DataContext.HidePackageCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="SecondaryButton" Content="{Binding DownloadLabel}"
                                            Command="{Binding DownloadCommand}"
                                            IsVisible="{Binding !IsDownloading}" />
                                    <Button Classes="GhostButton" Content="{Binding CancelLabel}"
                                            Command="{Binding CancelDownloadCommand}"
                                            IsVisible="{Binding IsDownloading}" />
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================ Empty / no-match state ============================ -->
            <Border Classes="ContentCard" IsVisible="{Binding !HasLoadedPackages}">
                <TextBlock Text="Press Refresh to retrieve packages from the selected source."
                           Classes="BodySmall" HorizontalAlignment="Center" Margin="0,24,0,24" />
            </Border>

            <Border Classes="ContentCard" IsVisible="{Binding HasLoadedPackages}">
                <StackPanel>
                    <TextBlock Text="{Binding NoMatchingDownloadsLabel}" Classes="BodySmall"
                               HorizontalAlignment="Center" Margin="0,24,0,24"
                               IsVisible="{Binding !HasVisiblePackages}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}"
                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                IsVisible="{Binding HasHiddenPackages}">
                        <Button Classes="GhostButton" Content="{Binding HideAllLabel}"
                                Command="{Binding HideAllPackagesCommand}" />
                        <Button Classes="SecondaryButton" Content="{Binding ShowHiddenDownloadsLabel}"
                                Command="{Binding ShowHiddenPackagesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
