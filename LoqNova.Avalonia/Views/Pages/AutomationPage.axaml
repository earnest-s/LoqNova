<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             xmlns:services="clr-namespace:LoqNova.Avalonia.Services"
             x:Class="LoqNova.Avalonia.Views.Pages.AutomationPage"
             x:DataType="vm:AutomationViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="TriggerOptionTemplate" x:DataType="services:TriggerOption">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
        <DataTemplate x:Key="StepOptionTemplate" x:DataType="services:AutomationStepOption">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
        <DataTemplate x:Key="StateOptionTemplate" x:DataType="vm:StepStateOption">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Classes="PageContainer">
        <StackPanel Spacing="24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="12">
<TextBlock Text="Automation" Classes="PageTitle" />

                <!-- Editor failures must be visible. Without this the Add step button
                     simply did nothing when a backend step could not be created, because
                     the reason was only written to the debug output. -->
                <Border Classes="ContentCard" Padding="10" Margin="0,8,0,0"
                        Background="#33FF6B6B"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11" />
                </Border>

                <ToggleSwitch IsChecked="{Binding IsAutomationEnabled}"
                              OnContent="Enabled" OffContent="Disabled"
                              VerticalAlignment="Center" />

                <!-- Real trigger types, labelled by the backend's own DisplayName. -->
                <ComboBox Classes="Control" Width="240" VerticalAlignment="Center"
                          ItemTemplate="{StaticResource TriggerOptionTemplate}"
                          ItemsSource="{Binding AvailableTriggers}"
                          SelectedItem="{Binding SelectedTriggerOption, Mode=TwoWay}" />

                <Button Classes="PrimaryButton" Content="Add Automatic"
                        Command="{Binding AddAutomaticPipelineCommand}" />

<Button Classes="PrimaryButton" Content="Add Manual"
                            Command="{Binding OpenManualNamePromptCommand}" />

                <!-- WPF asks for the name inline, capped at 50 characters. -->
                <TextBox Classes="Control" Width="200" MaxLength="50"
                         Watermark="Quick action name"
                         IsVisible="{Binding IsManualNamePromptOpen}"
                         Text="{Binding PendingManualName, Mode=TwoWay}" />

                <Button Classes="SecondaryButton" Content="OK"
                        IsVisible="{Binding IsManualNamePromptOpen}"
                        Command="{Binding AddManualPipelineCommand}" />

                <Button Classes="GhostButton" Content="Cancel"
                        IsVisible="{Binding IsManualNamePromptOpen}"
                        Command="{Binding CancelManualNamePromptCommand}" />

                <Button Classes="SecondaryButton" Content="Save"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsDirty}" />

                <Button Classes="GhostButton" Content="Revert"
                        Command="{Binding RevertCommand}"
                        IsVisible="{Binding IsDirty}" />
            </StackPanel>

            <!-- Automatic pipelines -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="8">
                    <TextBlock Text="Automatic Pipelines" Classes="SectionHeader" />

                    <TextBlock Classes="Caption" Opacity="0.6"
                               IsVisible="{Binding !AutomaticPipelines.Count}"
                               Text="No automatic pipelines configured." />

                    <ItemsControl ItemsSource="{Binding AutomaticPipelines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutomationPipelineViewModel">
                                <Border Classes="FeatureCard" Margin="0,4,0,0" Padding="12">
                                    <StackPanel Spacing="8">

                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                       Classes="Body" FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TriggerDisplayName}"
                                                       Classes="Caption" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Classes="IconButton" ToolTip.Tip="Move up"
                                                    Tag="{Binding}" Click="OnPipelineMoveUpClick">
                                                    <PathIcon Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                            <Button Classes="IconButton" ToolTip.Tip="Move down"
                                                    Tag="{Binding}" Click="OnPipelineMoveDownClick">
                                                    <PathIcon Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                            <Button Classes="IconButton" ToolTip.Tip="Remove"
                                                    Tag="{Binding}" Click="OnPipelineRemoveClick">
                                                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Trigger" Classes="Caption"
                                                       VerticalAlignment="Center" MinWidth="52" />
                                            <ComboBox Classes="Control" Width="280"
                                                      ItemTemplate="{StaticResource TriggerOptionTemplate}"
                                                      ItemsSource="{Binding TriggerOptions}"
                                                      SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Name" Classes="Caption"
                                                       VerticalAlignment="Center" MinWidth="52" />
                                            <TextBox Classes="Control" Width="280"
                                                     Text="{Binding Name, Mode=TwoWay}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding StepsSubtitle}"
                                                   Classes="Caption" Opacity="0.6" />

                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AutomationStepViewModel">
                                                    <Border Margin="16,4,0,0" Padding="8,4"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Classes="BodySmall"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ConfigurationSummary}"
                                                                       Classes="Caption" Opacity="0.7"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Real values from the backend's own
                                                                 GetAllStatesAsync, shown only when
                                                                 the step actually takes a state. -->
                                                            <ComboBox Classes="Control" Width="170"
                                                                      IsVisible="{Binding HasConfiguration}"
                                                                      ItemTemplate="{StaticResource StateOptionTemplate}"
                                                                      ItemsSource="{Binding States}"
                                                                      SelectedItem="{Binding SelectedState, Mode=TwoWay}" />

                                                            <Button Classes="IconButton" ToolTip.Tip="Move up"
                                                                    Tag="{Binding}" Click="OnStepMoveUpClick">
                                                                    <PathIcon Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                            <Button Classes="IconButton" ToolTip.Tip="Move down"
                                                                    Tag="{Binding}" Click="OnStepMoveDownClick">
                                                                    <PathIcon Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                            <Button Classes="IconButton" ToolTip.Tip="Remove"
                                                                    Tag="{Binding}" Click="OnStepRemoveClick">
                                                                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,4,0,0">
                                            <ComboBox Classes="Control" Width="260"
                                                      ItemTemplate="{StaticResource StepOptionTemplate}"
                                                      ItemsSource="{Binding StepOptions}"
                                                      SelectedItem="{Binding SelectedStepOption, Mode=TwoWay}" />
                                            <Button Classes="SecondaryButton" Content="Add step"
                                                    Tag="{Binding}"
                                                    Click="OnAddStepClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Quick actions -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick Actions (Manual)" Classes="SectionHeader" />

                    <TextBlock Classes="Caption" Opacity="0.6"
                               IsVisible="{Binding !ManualPipelines.Count}"
                               Text="No manual actions configured." />

                    <ItemsControl ItemsSource="{Binding ManualPipelines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutomationPipelineViewModel">
                                <Border Classes="FeatureCard" Margin="0,4,0,0" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                       Classes="Body" FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding StepsSubtitle}"
                                                       Classes="Caption" Margin="12,0,0,0"
                                                       Opacity="0.6" VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Classes="SecondaryButton" Content="Run"
                                                    Tag="{Binding}" Click="OnPipelineRunNowClick" />
                                            <Button Classes="IconButton" ToolTip.Tip="Move up"
                                                    Tag="{Binding}" Click="OnPipelineMoveUpClick">
                                                    <PathIcon Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                            <Button Classes="IconButton" ToolTip.Tip="Move down"
                                                    Tag="{Binding}" Click="OnPipelineMoveDownClick">
                                                    <PathIcon Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                            <Button Classes="IconButton" ToolTip.Tip="Remove"
                                                    Tag="{Binding}" Click="OnPipelineRemoveClick">
                                                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Name" Classes="Caption"
                                                       VerticalAlignment="Center" MinWidth="52" />
                                            <TextBox Classes="Control" Width="280"
                                                     Text="{Binding Name, Mode=TwoWay}" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AutomationStepViewModel">
                                                    <Border Margin="16,4,0,0" Padding="8,4"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Classes="BodySmall"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ConfigurationSummary}"
                                                                       Classes="Caption" Opacity="0.7"
                                                                       VerticalAlignment="Center" />

                                                            <ComboBox Classes="Control" Width="170"
                                                                      IsVisible="{Binding HasConfiguration}"
                                                                      ItemTemplate="{StaticResource StateOptionTemplate}"
                                                                      ItemsSource="{Binding States}"
                                                                      SelectedItem="{Binding SelectedState, Mode=TwoWay}" />

                                                            <Button Classes="IconButton" ToolTip.Tip="Move up"
                                                                    Tag="{Binding}" Click="OnStepMoveUpClick">
                                                                    <PathIcon Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                            <Button Classes="IconButton" ToolTip.Tip="Move down"
                                                                    Tag="{Binding}" Click="OnStepMoveDownClick">
                                                                    <PathIcon Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                            <Button Classes="IconButton" ToolTip.Tip="Remove"
                                                                    Tag="{Binding}" Click="OnStepRemoveClick">
                                                                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,4,0,0">
                                            <ComboBox Classes="Control" Width="260"
                                                      ItemTemplate="{StaticResource StepOptionTemplate}"
                                                      ItemsSource="{Binding StepOptions}"
                                                      SelectedItem="{Binding SelectedStepOption, Mode=TwoWay}" />
                                            <Button Classes="SecondaryButton" Content="Add step"
                                                    Tag="{Binding}"
                                                    Click="OnAddStepClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
