<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             x:Class="LoqNova.Avalonia.Views.Pages.AutomationPage"
             x:DataType="vm:AutomationViewModel">

    <Design.DataContext>
        <vm:AutomationViewModel />
    </Design.DataContext>

    <ScrollViewer Classes="PageContainer">
        <StackPanel Spacing="24">
            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Automation" Classes="PageTitle" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <ToggleSwitch IsChecked="{Binding IsAutomationEnabled}" OnContent="Enabled" OffContent="Disabled" />
                    <Button Classes="PrimaryButton" Content="Add Automatic" Command="{Binding AddAutomaticPipelineCommand}" />
                    <Button Classes="PrimaryButton" Content="Add Manual" Command="{Binding AddManualPipelineCommand}" />
                    <Button Classes="SecondaryButton" Content="Save" Command="{Binding SaveCommand}"
                            IsVisible="{Binding IsDirty}" />
                    <Button Classes="GhostButton" Content="Revert" Command="{Binding RevertCommand}"
                            IsVisible="{Binding IsDirty}" />
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4"
                                 IsVisible="{Binding IsLoading}" />
                </StackPanel>
            </StackPanel>
            
            <!-- Automatic Pipelines -->
            <Border Classes="ContentCard">
                <StackPanel>
                    <TextBlock Text="Automatic Pipelines" Classes="SectionHeader" />
                    
                    <ItemsControl ItemsSource="{Binding AutomaticPipelines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="FeatureCard" Margin="0,8,0,0">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <PathIcon Data="{Binding Icon}" Width="24" Height="24" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" Classes="Body" FontWeight="Medium" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TriggerTypeName}" Classes="Caption" VerticalAlignment="Center" Margin="16,0,0,0" />
                                            
                                            <Button Classes="IconButton" ToolTip.Tip="Remove" Command="{Binding $parent[Window].DataContext.RemovePipelineCommand}" CommandParameter="{Binding}">
                                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                        </StackPanel>
                                        
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="36,8,0,0" Padding="8,4" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding Name}" Classes="BodySmall" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TypeName}" Classes="Caption" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                                                            
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            
            <!-- Manual Pipelines (Quick Actions) -->
            <Border Classes="ContentCard">
                <StackPanel>
                    <TextBlock Text="Quick Actions (Manual)" Classes="SectionHeader" />
                    
                    <ItemsControl ItemsSource="{Binding ManualPipelines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="FeatureCard" Margin="0,8,0,0">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <PathIcon Data="{Binding Icon}" Width="24" Height="24" Foreground="{StaticResource SecondaryBrush}" />
                                            <TextBlock Text="{Binding Name}" Classes="Body" FontWeight="Medium" VerticalAlignment="Center" />
                                            
                                            <Button Classes="IconButton" ToolTip.Tip="Remove" Command="{Binding $parent[Window].DataContext.RemovePipelineCommand}" CommandParameter="{Binding}">
                                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" />
                                            </Button>
                                        </StackPanel>
                                        
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="36,8,0,0" Padding="8,4" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding Name}" Classes="BodySmall" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TypeName}" Classes="Caption" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                                                            
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>