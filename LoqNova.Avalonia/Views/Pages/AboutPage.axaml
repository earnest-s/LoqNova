<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             xmlns:icons="clr-namespace:LoqNova.Avalonia.Styles"
             x:Class="LoqNova.Avalonia.Views.Pages.AboutPage"
             x:DataType="vm:AboutViewModel">

    <Design.DataContext>
        <vm:AboutViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- External link: the WPF page uses its Link24 glyph for these. -->
        <DataTemplate x:Key="ExternalLinkTemplate" x:DataType="vm:AboutLink">
            <Button Classes="LinkButton" Command="{Binding Command}" Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <PathIcon Data="{x:Static icons:IconGeometries.OpenExternal}"
                              Width="{StaticResource IconSizeSm}"
                              Height="{StaticResource IconSizeSm}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Folder link: the WPF page uses its Folder24 glyph for these. -->
        <DataTemplate x:Key="FolderLinkTemplate" x:DataType="vm:AboutLink">
            <Button Classes="LinkButton" Command="{Binding Command}" Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <PathIcon Data="{x:Static icons:IconGeometries.Folder}"
                              Width="{StaticResource IconSizeSm}"
                              Height="{StaticResource IconSizeSm}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Classes="PageContainer">
        <StackPanel Margin="0,0,16,12">
            <TextBlock Text="{Binding Title}" Classes="PageTitle" />

            <!-- Application identity: the same lines WPF's AboutPage shows, in the
                 same order, with the real version and build of the running binary. -->
            <StackPanel Margin="0,24,0,0">
                <TextBlock Text="{Binding AppName}" Classes="Heading4" />
                <TextBlock Text="{Binding VersionText}" Classes="Body"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding BuildText}" Classes="Body"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Copyright}" Classes="Body"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,0" />
                <TextBlock Text="{Binding TranslationCredit}" Classes="BodySmall"
                           Foreground="{StaticResource TextMutedBrush}"
                           IsVisible="{Binding ShowTranslationCredit}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Links -->
            <TextBlock Text="{Binding LinksLabel}" Classes="SectionHeader" Margin="0,24,0,8" />
            <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource ExternalLinkTemplate}" />

            <!-- Third-party libraries, in the same three columns as the WPF page. -->
            <TextBlock Text="{Binding ThirdPartyLibrariesLabel}" Classes="SectionHeader" Margin="0,24,0,8" />
            <Grid ColumnDefinitions="Auto,Auto,Auto">
                <ItemsControl Grid.Column="0" Margin="0,0,32,0" ItemsSource="{Binding LibraryColumns[0]}"
                              ItemTemplate="{StaticResource ExternalLinkTemplate}" />
                <ItemsControl Grid.Column="1" Margin="0,0,32,0" ItemsSource="{Binding LibraryColumns[1]}"
                              ItemTemplate="{StaticResource ExternalLinkTemplate}" />
                <ItemsControl Grid.Column="2" ItemsSource="{Binding LibraryColumns[2]}"
                              ItemTemplate="{StaticResource ExternalLinkTemplate}" />
            </Grid>

            <!-- Application folders -->
            <TextBlock Text="{Binding ApplicationFoldersLabel}" Classes="SectionHeader" Margin="0,24,0,8" />
            <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderLinkTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
