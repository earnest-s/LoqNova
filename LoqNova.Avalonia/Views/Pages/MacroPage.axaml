<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             x:Class="LoqNova.Avalonia.Views.Pages.MacroPage"
             x:DataType="vm:MacroViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <!-- One number-pad key. WPF paints the selected key with the primary
             appearance and every other key with the secondary appearance. -->
        <DataTemplate x:Key="PadKeyTemplate" DataType="vm:MacroPadKey">
            <Button Classes="KeyPadKey"
                    Classes.selected="{Binding IsSelected}"
                    Content="{Binding Label}"
                    Command="{Binding $parent[UserControl].((vm:MacroViewModel)DataContext).SelectPadKeyCommand}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Cursor="{Binding IsWaitCursor, Converter={x:Static BoolConverters.IsCursorWait}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,12" Spacing="0">

                <!-- Page heading, matching the WPF title and subtitle -->
                <TextBlock Margin="0,16,0,8" FontSize="24" FontWeight="Medium" Text="Macro" />
                <TextBlock Margin="0,0,0,24"
                           Text="You can record series of key presses and invoke them using the number pad on your keyboard." />

                <!-- Enable. Bound to MacroController.IsEnabled, written through SetEnabled. -->
                <Border Classes="ContentCard" Margin="0,0,0,32">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="Heading4" Text="Enable" />
                        <TextBlock Classes="BodySmall" Text="LOQ Nova must be running for macros to work." />
                        <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Enable"
                                      OnContent="Enabled"
                                      OffContent="Disabled" />
                    </StackPanel>
                </Border>

                <!-- Number pad on the left, sequence on the right, as in the WPF Grid -->
                <Grid ColumnDefinitions="Auto,*">
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="Auto,Auto,Auto">
                        <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding PadKeys[0]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding PadKeys[1]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                        <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding PadKeys[2]}" ContentTemplate="{StaticResource PadKeyTemplate}" />

                        <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding PadKeys[3]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding PadKeys[4]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                        <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding PadKeys[5]}" ContentTemplate="{StaticResource PadKeyTemplate}" />

                        <ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding PadKeys[6]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                        <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding PadKeys[7]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                        <ContentControl Grid.Row="2" Grid.Column="2" Content="{Binding PadKeys[8]}" ContentTemplate="{StaticResource PadKeyTemplate}" />

                        <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding PadKeys[10]}" ContentTemplate="{StaticResource PadKeyTemplate}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="32,0,0,0" Spacing="8">

                        <!-- Repeat. WPF fills this from MacroController.AllowedRepeatCounts
                             and labels 1 as "Don't repeat". -->
                        <Border Classes="ContentCard" IsEnabled="{Binding HasEvents}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Heading4" Text="Repeat" />
                                <ComboBox MinWidth="150"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding RepeatOptions}"
                                          SelectedValue="{Binding RepeatCount, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Value}"
                                          AutomationProperties.Name="Repeat">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:MacroRepeatOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Classes="ContentCard" IsEnabled="{Binding HasEvents}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Heading4" Text="Ignore delays" />
                                <ToggleSwitch IsChecked="{Binding IgnoreDelays, Mode=TwoWay}"
                                              OnContent="On" OffContent="Off"
                                              AutomationProperties.Name="Ignore delays" />
                            </StackPanel>
                        </Border>

                        <Border Classes="ContentCard" IsEnabled="{Binding HasEvents}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Heading4" Text="Interrupt if another key was pressed" />
                                <ToggleSwitch IsChecked="{Binding InterruptOnOtherKey, Mode=TwoWay}"
                                              OnContent="On" OffContent="Off"
                                              AutomationProperties.Name="Interrupt if another key was pressed" />
                            </StackPanel>
                        </Border>

                        <!-- Recording options. Read when Record is pressed, never on change. -->
                        <Border Classes="ContentCard" Margin="0,0,0,8">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Heading4" Text="Recording options" />
                                <ComboBox MinWidth="150"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding RecorderOptions}"
                                          SelectedValue="{Binding RecorderSettings, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Value}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:MacroRecorderOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Record is always available, exactly as WPF's Set leaves _recordButton.IsEnabled
                         true. Only Clear is conditional, because WPF collapses just
                         _clearButton when the sequence has no events. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Classes="IconButton"
                                    ToolTip.Tip="Clear"
                                    Command="{Binding ClearCommand}"
                                    IsVisible="{Binding HasEvents}">
                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z"
                                          Width="20" Height="20" />
                            </Button>

                            <Button Classes="PrimaryButton"
                                    MinWidth="150"
                                    Content="Record"
                                    Command="{Binding RecordCommand}"
                                    IsVisible="{Binding !IsRecording}" />
                        </StackPanel>

                        <!-- Read-only event cards. WPF has no event editing UI, and the
                             panel is always present; it is simply empty when the
                             sequence has no events. -->
                        <ItemsControl ItemsSource="{Binding EventCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MacroEventCardViewModel">
                                    <Border Classes="ContentCard" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Icon}"
                                                       Classes="Heading4"
                                                       VerticalAlignment="Center"
                                                       Width="28"
                                                       TextAlignment="Center" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" Classes="Heading4" />
                                                <TextBlock Text="{Binding Subtitle}" Classes="BodySmall" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Avalonia equivalent of WPF's topmost MacroRecordingWindow: a small
             always-visible card that does not steal focus, because the recorder hooks
             swallow input while it runs. -->
        <Border IsVisible="{Binding IsRecording}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,24,0,0"
                Padding="20,16"
                CornerRadius="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="&#x23F8;" FontSize="32" VerticalAlignment="Center"
                           IsVisible="{Binding IsPreparing}" />
                <TextBlock Text="&#x25CF;" FontSize="32" VerticalAlignment="Center"
                           Foreground="{StaticResource DangerBrush}"
                           IsVisible="{Binding IsCapturing}" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="Heading4"
                               Text="Recording will start in 3 seconds..."
                               IsVisible="{Binding IsPreparing}" />
                    <TextBlock Classes="Heading4"
                               Text="Recording..."
                               IsVisible="{Binding IsCapturing}" />
                    <TextBlock Classes="BodySmall"
                               Text="Press ESC to stop."
                               IsVisible="{Binding IsCapturing}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>