<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Pages"
             x:Class="LoqNova.Avalonia.Views.Controls.Dashboard.DashboardWidget"
             x:DataType="vm:DashboardWidgetViewModel">

    <Border Classes="FeatureCard">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <PathIcon Data="{Binding Icon}" Width="20" Height="20" Foreground="{Binding Color}" />
                <TextBlock Text="{Binding Title}" Classes="CardTitle" />
            </StackPanel>
            
            <!-- Content based on widget type -->
            <ContentControl Grid.Row="1" Content="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ContentControl.ContentTemplateSelector>
                    <local:WidgetTemplateSelector xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.Dashboard" />
                </ContentControl.ContentTemplateSelector>
            </ContentControl>
            
            <!-- Footer/Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Classes="IconButton" ToolTip.Tip="Configure" IsVisible="{Binding Type, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=combo}">
                    <PathIcon Data="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.59-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.56.24-1.09.56-1.59.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.07.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.59.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.56-.24 1.09-.56 1.59-.94l2.39.96c.22.07.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>