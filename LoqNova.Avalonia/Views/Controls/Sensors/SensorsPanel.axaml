<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:LoqNova.Avalonia.Styles"
             x:Class="LoqNova.Avalonia.Views.Controls.Sensors.SensorsPanel">

    <!-- Five equal star columns: the tiles stay aligned with each other and
         share the full width at any window size, so no dead space appears.
         Every value is read from the library sensor controller; a channel the
         machine does not report is rendered as a dash by the bound text
         properties, and each bar is driven by the machine-reported maximum. -->
    <Grid ColumnDefinitions="*,*,*,*,*,*">

        <!-- ============================ CPU utilisation ============================ -->
        <Border Grid.Column="0" Classes="SensorCard" Margin="0,0,6,0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="SensorAccentCpu" />

                <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <PathIcon Data="{x:Static icons:IconGeometries.Cpu}"
                                  Classes="SensorIcon"
                                  Foreground="{StaticResource SensorCpuBrush}" />
                        <TextBlock Text="CPU" Classes="SensorCardTitle SensorLabelCpu" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                        <TextBlock Text="{Binding CpuUtilizationText}"
                                   Classes="SensorCardValue" TextWrapping="NoWrap"
                                   Foreground="{StaticResource SensorCpuBrush}" />
                        <TextBlock Text="%" Classes="SensorCardUnit" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- WPF shows the CPU core clock in GHz under the utilisation. -->
                    <TextBlock Classes="SensorCardMeta" Margin="0,2,0,0"
                               Text="{Binding CpuCoreClockText}" />

                    <ProgressBar Value="{Binding CpuUtilizationRatio}" Classes="CpuUsageBar" Maximum="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ GPU utilisation ============================ -->
        <Border Grid.Column="1" Classes="SensorCard" Margin="0,0,6,0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="SensorAccentGpu" />

                <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <PathIcon Data="{x:Static icons:IconGeometries.Gpu}"
                                  Classes="SensorIcon"
                                  Foreground="{StaticResource SensorGpuBrush}" />
                        <TextBlock Text="GPU" Classes="SensorCardTitle SensorLabelGpu" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                        <TextBlock Text="{Binding GpuUtilizationText}"
                                   Classes="SensorCardValue" TextWrapping="NoWrap"
                                   Foreground="{StaticResource SensorGpuBrush}" />
                        <TextBlock Text="%" Classes="SensorCardUnit" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- WPF shows the GPU core and memory clocks in MHz. -->
                    <TextBlock Classes="SensorCardMeta" Margin="0,2,0,0"
                               Text="{Binding GpuCoreClockText}" />
                    <TextBlock Classes="SensorCardMeta" Margin="0,1,0,0"
                               Text="{Binding GpuMemoryClockText}" />

                    <ProgressBar Value="{Binding GpuUtilizationRatio}" Classes="GpuUsageBar" Maximum="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ CPU temperature ============================ -->
        <Border Grid.Column="2" Classes="SensorCard" Margin="0,0,6,0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="SensorAccentTemp" />

                <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <PathIcon Data="{x:Static icons:IconGeometries.Thermometer}"
                                  Classes="SensorIcon"
                                  Foreground="{StaticResource SensorTempBrush}" />
                        <TextBlock Text="CPU TEMP" Classes="SensorCardTitle SensorLabelTemp" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                        <TextBlock Text="{Binding CpuTemperatureText}"
                                   Classes="SensorCardValue" TextWrapping="NoWrap"
                                   Foreground="{StaticResource SensorTempBrush}" />
                        <TextBlock Text="°C" Classes="SensorCardUnit" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <ProgressBar Value="{Binding CpuTemperatureRatio}" Classes="TemperatureBar" Maximum="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ GPU temperature ============================ -->
        <Border Grid.Column="3" Classes="SensorCard" Margin="0,0,6,0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="SensorAccentTemp" />

                <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <PathIcon Data="{x:Static icons:IconGeometries.Thermometer}"
                                  Classes="SensorIcon"
                                  Foreground="{StaticResource SensorTempBrush}" />
                        <TextBlock Text="GPU TEMP" Classes="SensorCardTitle SensorLabelTemp" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                        <TextBlock Text="{Binding GpuTemperatureText}"
                                   Classes="SensorCardValue" TextWrapping="NoWrap"
                                   Foreground="{StaticResource SensorTempBrush}" />
                        <TextBlock Text="°C" Classes="SensorCardUnit" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <ProgressBar Value="{Binding GpuTemperatureRatio}" Classes="TemperatureBar" Maximum="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ CPU fan ============================ -->
        <Border Grid.Column="4" Classes="SensorCard">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="SensorAccentFan" />

                <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <PathIcon Data="{x:Static icons:IconGeometries.Fan}"
                                  Classes="SensorIcon"
                                  Foreground="{StaticResource SensorFanBrush}" />
                        <TextBlock Text="CPU FAN" Classes="SensorCardTitle SensorLabelFan" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                        <TextBlock Text="{Binding CpuFanSpeedText}"
                                   Classes="SensorCardValue" TextWrapping="NoWrap"
                                   Foreground="{StaticResource SensorFanBrush}" />
                        <TextBlock Text="RPM" Classes="SensorCardUnit" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- Secondary line derived from the same real reading -->
                    <TextBlock Classes="SensorCardMeta" Margin="0,2,0,0"
                               Text="{Binding CpuFanSpeedMaxText}" />

                    <ProgressBar Value="{Binding CpuFanSpeedRatio}" Classes="FanSpeedBar" Maximum="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ GPU fan ============================ -->
        <Border Grid.Column="5" Classes="SensorCard">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="SensorAccentFan" />

                <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <PathIcon Data="{x:Static icons:IconGeometries.Fan}"
                                  Classes="SensorIcon"
                                  Foreground="{StaticResource SensorFanBrush}" />
                        <TextBlock Text="GPU FAN" Classes="SensorCardTitle SensorLabelFan" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                        <TextBlock Text="{Binding GpuFanSpeedText}"
                                   Classes="SensorCardValue" TextWrapping="NoWrap"
                                   Foreground="{StaticResource SensorFanBrush}" />
                        <TextBlock Text="RPM" Classes="SensorCardUnit" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- Reported as-is, including zero when the machine reports none. -->
                    <TextBlock Classes="SensorCardMeta" Margin="0,2,0,0"
                               Text="{Binding GpuFanSpeedMaxText}" />

                    <ProgressBar Value="{Binding GpuFanSpeedRatio}" Classes="FanSpeedBar" Maximum="1" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
