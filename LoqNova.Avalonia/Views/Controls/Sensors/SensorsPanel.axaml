<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.Sensors"
             x:Class="LoqNova.Avalonia.Views.Controls.Sensors.SensorsPanel"
             x:Name="Root">

    <ItemsControl x:Name="Tiles">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- Uniform rows that reflow on resize; no fixed column count
                     and no MaxWidth, so the dashboard never reserves dead space. -->
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>

</UserControl>
