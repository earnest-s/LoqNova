<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:LoqNova.Avalonia.Styles"
             xmlns:vm="clr-namespace:LoqNova.Avalonia.ViewModels.Controls"
             x:Class="LoqNova.Avalonia.Views.Controls.Sensors.SensorsPanel"
             x:DataType="vm:DashboardMetricSource">

    <!-- Telemetry cards driven by the live sensor controller. The card layout is
         unchanged; the metrics and their maxima now come from the backend, and
         unreported channels render as "--" with an empty bar, as WPF does. -->
    <ItemsControl ItemsSource="{Binding SensorMetrics}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:ResponsiveUniformGrid ItemWidth="212" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SensorMetricViewModel">
                <Border Classes="SensorCard" Margin="0,0,6,6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Classes="SensorAccent"
                                Background="{Binding AccentKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />

                        <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                <PathIcon Data="{Binding IconKey, Converter={StaticResource IconNameToGeometryConverter}}"
                                          Classes="SensorIcon"
                                          Foreground="{Binding AccentKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                                <TextBlock Text="{Binding Label}"
                                           Classes="SensorCardTitle"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding AccentKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                                <TextBlock Text="{Binding ValueText}"
                                           Classes="SensorCardValue"
                                           TextWrapping="NoWrap"
                                           Foreground="{Binding AccentKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                                <TextBlock Text="{Binding Unit}"
                                           Classes="SensorCardUnit"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>

                            <!-- WPF shows the observed maximum as a secondary line. -->
                            <TextBlock Classes="SensorCardMeta" Margin="0,2,0,0"
                                       Text="{Binding MaximumText, Converter={StaticResource AppendMaxConverter}}" />

                            <!-- Ratio of value to the machine-reported maximum, not a fixed 100. -->
                            <ProgressBar Value="{Binding Ratio}" Maximum="1" Classes="SensorBar" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
