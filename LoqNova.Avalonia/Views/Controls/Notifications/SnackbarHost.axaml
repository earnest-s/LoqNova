<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoqNova.Avalonia.Views.Controls.Notifications.SnackbarHost">

    <ItemsControl x:Name="SnackbarItems" ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="20" Height="20" Foreground="{Binding IconColor}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Message}" Classes="BodySmall" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="GhostButton" Padding="4" Command="{Binding CloseCommand}">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 19 17.59 13.41 12z" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>