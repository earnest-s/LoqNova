<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="using:Avalonia.Controls.ColorPicker"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker"
             x:DataType="local:ZoneColorPicker">

    <!-- One RGB zone.
         Every binding targets the control itself via $self, because the inherited
         DataContext is the page ViewModel, which owns no Color or ZoneNumber.
         Binding to the DataContext is what previously left these cards blank.

         The picker is Avalonia's own ColorView rather than a fixed swatch list,
         matching the decision that there is no discrete palette to reproduce. WPF
         offers a continuous 2D colour square plus hex/RGB entry, so no fixed set
         of swatch values is authoritative to copy. -->

    <Border Name="Card" Classes="FeatureCard" Padding="12">
        <StackPanel Spacing="8">

            <TextBlock Text="{Binding $self.ZoneNumber, StringFormat='ZONE {0}', Mode=OneWay}"
                       Classes="CardTitle" />

            <!-- Large preview of the zone's authoritative colour -->
            <Border Height="52"
                    CornerRadius="4"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Background="{Binding $self.Color, Mode=OneWay, Converter={StaticResource RgbZoneColorToBrushConverter}}" />

            <!-- Native colour editor. Alpha is hidden: the backend colour is RGB only. -->
            <cp:ColorView Color="{Binding $self.Color, Mode=TwoWay, Converter={StaticResource RgbZoneColorConverter}}"
                          IsAlphaVisible="False"
                          IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
