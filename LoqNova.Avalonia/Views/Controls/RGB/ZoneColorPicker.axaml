<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker"
             x:DataType="local:ZoneColorPicker">

    <!-- One RGB zone, kept deliberately small.

         The colour editor is hidden by default and shown by clicking the swatch.
         Inline and always-open, four native editors made the page unusable and gave
         four competing colour surfaces that looked like decoration rather than
         controls.

         Every binding uses $self because the inherited DataContext is the page
         ViewModel, which has no Color or ZoneNumber. Binding to the DataContext is
         what previously left these cards blank. -->

    <Border Name="Card" Classes="FeatureCard" Padding="10" Background="Transparent">
        <StackPanel Spacing="6">

            <TextBlock Text="{Binding $self.ZoneNumber, StringFormat='ZONE {0}', Mode=OneWay}"
                       Classes="CardTitle" />

            <!-- The swatch is both the current-colour readout and the editor trigger. -->
            <Button Name="PickButton"
                    Height="44"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}"
                    Click="OnPickClicked"
                    ToolTip.Tip="Change this zone's colour">
                <Border CornerRadius="4"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Background="{Binding $self.Color, Mode=OneWay, Converter={StaticResource RgbZoneColorToBrushConverter}}" />
            </Button>

            <!-- The zone's exact RGB, so the chosen value is unambiguous. -->
            <TextBlock Text="{Binding $self.Color, Mode=OneWay}"
                       Classes="CardSubtitle"
                       HorizontalAlignment="Center" />

            <!-- Avalonia's native colour editor. Revealed on demand; hidden entirely
                 otherwise so only one is ever on screen. Alpha is hidden because the
                 backend colour is RGB only. -->
            <ColorView Name="Editor"
                       IsVisible="False"
                       Width="240"
                       HorizontalAlignment="Left"
                       IsAlphaVisible="False"
                       ColorChanged="OnEditorColorChanged" />
        </StackPanel>
    </Border>
</UserControl>
