<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker">

    <!-- Zone colour. The swatch shows the current colour, the palette sets it, and
         the TwoWay Color binding carries the change through the ViewModel's single
         state-write path into the backend. "Synchronise zones" is the explicit action
         WPF exposes, not a persistent mode. -->
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding ZoneNumber, StringFormat='Zone {0}'}" Classes="Label" />

        <Border Width="72" Height="20" CornerRadius="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="{Binding Color, Converter={StaticResource RgbZoneColorToBrushConverter}}" />

        <Panel Name="PaletteHost" />

        <Button Classes="GhostButton"
                Content="Synchronise"
                Padding="6,2"
                FontSize="11"
                IsEnabled="{Binding IsInteractive}"
                Click="OnSynchroniseClick" />
    </StackPanel>
</UserControl>
