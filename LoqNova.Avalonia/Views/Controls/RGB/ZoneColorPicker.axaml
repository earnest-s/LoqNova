<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker"
             x:DataType="local:ZoneColorPicker">

    <!-- One RGB zone.

         Every binding targets the control itself via $self, because the inherited
         DataContext is the page ViewModel, which owns no Color or ZoneNumber.
         Binding to the DataContext is what previously left these cards blank.

         The large colour preview is also the picker trigger: clicking it opens a
         flyout holding Avalonia's native ColorView. Showing ColorView inline made
         the page enormous and put four unstyled spectrum/hex editors on screen at
         once. This mirrors WPF, where a colour button opens a popup editor.

         WPF offers a continuous 2D colour square plus hex/RGB entry, so there is no
         discrete swatch palette to reproduce. -->

    <Border Name="Card" Classes="FeatureCard" Padding="12" Background="Transparent">
        <StackPanel Spacing="8">

            <TextBlock Text="{Binding $self.ZoneNumber, StringFormat='ZONE {0}', Mode=OneWay}"
                       Classes="CardTitle" />

            <!-- Large preview of the authoritative colour, and the click target -->
            <Button Name="PickButton"
                    Height="52"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}">
                <Border CornerRadius="4"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Background="{Binding $self.Color, Mode=OneWay, Converter={StaticResource RgbZoneColorToBrushConverter}}" />

                <!-- Avalonia's native colour editor, hidden until the zone is clicked.
                     Its DataContext is pointed at this control in code, so this
                     binding resolves against the zone colour. -->
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <Grid Name="FlyoutRoot" Width="280">
                            <ColorView IsAlphaVisible="False"
                                       Color="{Binding Color, Mode=TwoWay, Converter={StaticResource RgbZoneColorConverter}}" />
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
