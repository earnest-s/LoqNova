<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker"
             x:DataType="local:ZoneColorPicker">

    <!-- One RGB zone, presented the way WPF does it: a colour button showing the
         current colour, which opens a picker to change it.

         The picker is hidden until the swatch is clicked, so only one is ever on
         screen. Every "Is..." toggle below trims the native ColorView down to what
         WPF's ColorPickerControl actually offers: a colour square plus hex entry.
         Left on, they add colour-model radios, per-component sliders, R/G/B text
         boxes and a palette, which is the clutter that made this look unfinished.

         Every binding uses $self because the inherited DataContext is the page
         ViewModel, which has no Color or ZoneNumber. -->

    <Border Name="Card" Classes="FeatureCard" Padding="10" Background="Transparent">
        <StackPanel Spacing="6">

            <TextBlock Text="{Binding $self.ZoneNumber, StringFormat='ZONE {0}', Mode=OneWay}"
                       Classes="CardTitle" />

            <!-- Current colour, and the trigger that opens the picker -->
            <Button Name="PickButton"
                    Height="44"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}"
                    Click="OnPickClicked"
                    ToolTip.Tip="Change this zone's colour">
                <Border CornerRadius="4"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Background="{Binding $self.Color, Mode=OneWay, Converter={StaticResource RgbZoneColorToBrushConverter}}" />
            </Button>

            <!-- WPF's per-zone "Synchronise zones" action. Shown as a button rather
                 than a hidden context menu, because a context menu is undiscoverable
                 and this is a required action. -->
            <Button Name="SyncButton"
                    Classes="GhostButton"
                    FontSize="11"
                    HorizontalAlignment="Stretch"
                    Content="Synchronise zones"
                    IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}"
                    Click="OnSyncClicked" />

            <!-- Picker, revealed on demand. Trimmed to a colour square plus hex:
                 the exact feature set of WPF's ColorPickerControl. -->
            <ColorView Name="Editor"
                       IsVisible="False"
                       Width="230"
                       HorizontalAlignment="Left"
                       IsAlphaEnabled="False"
                       IsColorModelVisible="False"
                       IsColorComponentsVisible="False"
                       IsComponentSliderVisible="False"
                       IsComponentTextInputVisible="False"
                       IsColorPaletteVisible="False"
                       IsAccentColorsVisible="False"
                       IsColorPreviewVisible="False" />
        </StackPanel>
    </Border>
</UserControl>
