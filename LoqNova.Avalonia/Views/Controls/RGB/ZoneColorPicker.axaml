<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker"
             x:DataType="local:ZoneColorPicker">

    <!-- One RGB zone, laid out the way WPF does it.

         WPF's ColorPickerControl is a small 38x38 colour button that opens a popup
         containing a 2D colour square plus hex/RGB entry. This mirrors that: a
         compact row of small swatch, zone name, hex value and a synchronise action,
         with the picker in a popup rather than expanding the card. Expanding inline
         made one card grow to the height of the colour square and left the section
         looking broken.

         The picker keeps only what WPF's control offers. The native ColorView also
         carries colour-model radios, per-component sliders, R/G/B text boxes and a
             palette, all switched off below. -->

    <Border Name="Card" Classes="FeatureCard" Padding="10" Background="Transparent">
        <StackPanel Spacing="8">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Small current-colour box, and the trigger that opens the picker -->
                <Button Name="PickButton"
                        Grid.Column="0"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}"
                        Click="OnPickClicked"
                        ToolTip.Tip="Change this zone's colour">
                    <Border CornerRadius="4"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            Background="{Binding $self.Color, Mode=OneWay, Converter={StaticResource RgbZoneColorToBrushConverter}}" />
                </Button>

                <StackPanel Grid.Column="1" Margin="10,0,10,0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding $self.ZoneNumber, StringFormat='ZONE {0}', Mode=OneWay}"
                               Classes="CardTitle" />
                    <TextBlock Text="{Binding $self.Color, Mode=OneWay}"
                               FontSize="11"
                               Opacity="0.7" />
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="GhostButton"
                        FontSize="11"
                        Content="Synchronise"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}"
                        Click="OnSyncClicked" />
            </Grid>

            <!-- WPF opens the colour editor in a popup anchored to the swatch, so the
                 card keeps its height. The editor is given no binding: the code-behind
                 pushes the zone colour in on open and reads the result back, which
                 keeps one path to the backend and avoids a silent converter failure. -->
            <Popup Name="PickerPopup"
                   PlacementTarget="PickButton"
                   Placement="BottomEdgeAlignedLeft"
                   AllowsTransparency="True"
                   IsLightDismissEnabled="True">
                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <ColorView Name="Editor"
                               Width="230"
                               IsAlphaEnabled="False"
                               IsColorModelVisible="False"
                               IsColorComponentsVisible="False"
                               IsComponentSliderVisible="False"
                               IsComponentTextInputVisible="False"
                               IsColorPaletteVisible="False"
                               IsAccentColorsVisible="False"
                               IsColorPreviewVisible="False" />
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
