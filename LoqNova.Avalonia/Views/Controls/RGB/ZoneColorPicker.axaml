<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker">

    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding $parent[UserControl].ZoneNumber, StringFormat='Zone {0}'}" Classes="Label" VerticalAlignment="Center" Width="80" />
            <Border Width="32" Height="32" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{Binding $parent[UserControl].Color, Converter={StaticResource RgbZoneColorToBrushConverter}}" />
        </StackPanel>
    </StackPanel>
</UserControl>