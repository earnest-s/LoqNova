<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoqNova.Avalonia.Views.Controls.RGB"
             x:Class="LoqNova.Avalonia.Views.Controls.RGB.ZoneColorPicker"
             x:DataType="local:ZoneColorPicker">

    <!-- One RGB zone.

         Every binding targets the control itself via $self, because the inherited
         DataContext is the page ViewModel, which owns no Color or ZoneNumber.
         Binding to the DataContext is what previously left these cards blank.

         The large colour preview is the picker trigger. The native editor stays
         collapsed until the zone is clicked: showing it inline and always-open put
         four full spectrum/hex editors on the page at once, which was unusable.

         WPF offers a continuous 2D colour square plus hex/RGB entry, so there is no
         discrete swatch palette to reproduce. -->

    <Border Name="Card" Classes="FeatureCard" Padding="12" Background="Transparent">
        <StackPanel Spacing="8">

            <TextBlock Text="{Binding $self.ZoneNumber, StringFormat='ZONE {0}', Mode=OneWay}"
                       Classes="CardTitle" />

            <!-- Large preview of the authoritative colour, and the click target -->
            <Button Name="PickButton"
                    Height="52"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPickClicked"
                    IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}">
                <Border CornerRadius="4"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Background="{Binding $self.Color, Mode=OneWay, Converter={StaticResource RgbZoneColorToBrushConverter}}" />
            </Button>

            <!-- Avalonia's native colour editor, revealed on demand. Alpha is hidden
                 because the backend colour is RGB only. -->
            <ColorView IsVisible="{Binding $self.IsPickerOpen, Mode=OneWay}"
                       Width="260"
                       HorizontalAlignment="Left"
                       IsAlphaVisible="False"
                       IsEnabled="{Binding $self.IsInteractive, Mode=OneWay}"
                       Color="{Binding $self.Color, Mode=TwoWay, Converter={StaticResource RgbZoneColorConverter}}" />
        </StackPanel>
    </Border>
</UserControl>
